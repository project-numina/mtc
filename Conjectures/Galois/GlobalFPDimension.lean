module
public import PropertyF.Ground.Target

/-!
# Galois invariance of the global FP dimension ideal

Status: solved
Source: Ostrik, arXiv:0810.3242, Corollary 1.3.
Declaration: MTC.Conjectures.Galois.globalFPDimension_dNumber

The ideal of algebraic integers generated by the global FP dimension is
Galois invariant. Equivalently, its image under every complex field
automorphism is divisible by it in the ring of algebraic integers. This
arithmetic condition restricts candidate dimensions. The frozen definition
must be identified with the standard FP dimension to apply the source.
-/

@[expose] public noncomputable section
namespace MTC.Conjectures.Galois
open PropertyF.Ground
universe v u

/-- Galois conjugates are divisible by the global dimension. -/
theorem globalFPDimension_dNumber (C : BraidedFusionCategory.{v,u})
    (σ : ℂ ≃+* ℂ) :
    IsIntegral ℤ (σ (globalFPDimension C : ℂ) / (globalFPDimension C : ℂ)) := by
  sorry

/-- The unit satisfies the numerical condition for every automorphism. -/
example (σ : ℂ ≃+* ℂ) : IsIntegral ℤ (σ (1 : ℂ) / 1) := by
  simpa using (isIntegral_one : IsIntegral ℤ (1 : ℂ))

end MTC.Conjectures.Galois
