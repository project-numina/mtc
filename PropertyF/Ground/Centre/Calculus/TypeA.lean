module
public import PropertyF.Ground.CentreCalculus.BraidRelations
public import PropertyF.Ground.Centre.Basic
public import PropertyF.Ground.Cabling.Naturality
public import Mathlib.GroupTheory.PresentedGroup
public import Mathlib.GroupTheory.Perm.Sign
public import Mathlib.GroupTheory.QuotientGroup.Defs
public import PropertyF.Ground.Centre.Calculus.TypeANormalWords

/-!
# The type-A presentation of the symmetric group

Square, adjacent braid and distant-commutativity relations give a quotient of
the free group. The notation `s i` denotes the adjacent swap at position `i`,
and `g n i` denotes the corresponding type-A quotient generator. A normal-form
cardinality bound identifies this quotient with the symmetric group, so
self-transparent braid actions factor through it.
-/
@[expose] public noncomputable section
open Equiv (Perm swap_comm swap_mul_swap_mul_swap)
open QuotientGroup (eq_iff_div_mem)
open Subgroup (subset_normalClosure)
open CategoryTheory CategoryTheory.MonoidalCategory
namespace PropertyF.Ground.CentreCalculus
universe v u
variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [BraidedCategory C]

/-- An object centralizing both canonical images centralizes itself. The
negative-image condition places it in the positive image, to which the
positive-image condition can then be applied. -/
theorem commonCentralizer_self (Y : CategoryTheory.Center C)
    (hp : ∀ X : C, Centre.Centralizes Y ((CategoryTheory.Center.ofBraided C).obj X))
    (hn : ∀ X : C, Centre.Centralizes Y ((Centre.negative C).obj X)) :
    Centre.Centralizes Y Y :=
  Centre.centralizes_symm <| Centre.centralizes_of_iso_left
    (Centre.positiveIsoOfCentralizesNegative Y hn) <| Centre.centralizes_symm (hp Y.1)


/-- Adjacent transpositions generate the full symmetric group. -/
theorem strandPermutation_surjective (n : ℕ) : Function.Surjective (strandPermutation n) :=
  FreeGroup.lift_surjective_iff_closure_range_eq_top.mpr <|
    Subgroup.closure_eq_top_of_mclosure_eq_top <| Equiv.Perm.mclosure_swap_castSucc_succ (n + 1)

/-- The transposition of consecutive positions in a finite strand set. -/
abbrev adjacentSwap {n : ℕ} (i : Fin n) : Perm (Fin (n + 1)) :=
  Equiv.swap i.castSucc i.succ

variable (X : C) (n : ℕ)
  (h : (strandPermutation n).ker ≤ (FreeGroup.lift (braidGenerator X n)).ker)

/-- Pure-word triviality is the precise remaining condition for the actual
braid action to factor through the symmetric group. -/
def permActionOfPureTrivial :
    Perm (Fin (n + 2)) →* Aut (tensorPower X (n + 2)) :=
  (QuotientGroup.lift _ (FreeGroup.lift (braidGenerator X n)) h).comp
    (QuotientGroup.liftEquiv _ (strandPermutation_surjective n) rfl).symm.toMonoidHom

/-- The descended action takes each adjacent transposition to its actual
categorical braid generator. -/
theorem permActionOfPureTrivial_swap (i : Fin (n + 1)) :
    permActionOfPureTrivial X n h (adjacentSwap i) = braidGenerator X n i :=
  (congrArg (QuotientGroup.lift _ (FreeGroup.lift (braidGenerator X n)) h)
    ((QuotientGroup.liftEquiv _ (strandPermutation_surjective n) rfl).symm_apply_apply
      (QuotientGroup.mk' _ (FreeGroup.of i)))).trans FreeGroup.lift_apply_of

end PropertyF.Ground.CentreCalculus

open CategoryTheory CategoryTheory.MonoidalCategory
namespace PropertyF.Ground.CentreCalculus
universe v u
variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [BraidedCategory C]

/-- The normal subgroup generated by squares of adjacent braid words. -/
def squareRelations (n : ℕ) : Set (BraidWords n) :=
  Set.range (fun i : Fin (n + 1) => FreeGroup.of i ^ 2)

local notation "s" => adjacentSwap

/-- Every square relation and all its conjugates act trivially on tensor
powers of a self-centralizing object. The full pure-word kernel also involves
the braid and distant-commutativity relations. -/
theorem squareRelations_action_trivial {X : C}
    (hX : SelfTransparent X) (n : ℕ) :
    Subgroup.normalClosure (squareRelations n) ≤
      (FreeGroup.lift (braidGenerator X n)).ker :=
  Subgroup.normalClosure_le_normal <| Set.range_subset_iff.mpr fun i ↦
    MonoidHom.mem_ker.mpr <| by
      simpa only [pow_two, map_mul, FreeGroup.lift_apply_of] using braidGenerator_involutive hX n i

/-- Adjacent Yang–Baxter and distant commutation words in the free group. -/
def braidRelations (n : ℕ) : Set (BraidWords n) :=
  {w | (∃ i j : Fin (n + 1), i.val + 1 = j.val ∧
      w = (FreeGroup.of i * FreeGroup.of j * FreeGroup.of i) *
        (FreeGroup.of j * FreeGroup.of i * FreeGroup.of j)⁻¹) ∨
    (∃ i j : Fin (n + 1), i.val + 1 < j.val ∧
      w = (FreeGroup.of i * FreeGroup.of j) * (FreeGroup.of j * FreeGroup.of i)⁻¹)}

/-- The normal subgroup generated by the type-A presentation relations. -/
def typeANormal (n : ℕ) : Subgroup (BraidWords n) :=
  Subgroup.normalClosure (squareRelations n ∪ braidRelations n)

instance (n : ℕ) : (typeANormal n).Normal := inferInstanceAs
  (Subgroup.normalClosure (squareRelations n ∪ braidRelations n)).Normal

/-- The full normal closure of the type-A braid relations acts trivially. -/
theorem braidRelations_action_trivial (X : C) (n : ℕ) :
    Subgroup.normalClosure (braidRelations n) ≤
      (FreeGroup.lift (braidGenerator X n)).ker :=
  Subgroup.normalClosure_le_normal fun w hw ↦ MonoidHom.mem_ker.mpr <| by
    rcases hw with ⟨i, j, hij, rfl⟩ | ⟨i, j, hij, rfl⟩ <;>
      simp only [map_mul, map_inv, FreeGroup.lift_apply_of, mul_inv_eq_one]
    · cases n with
      | zero => omega
      | succ n =>
        let k : Fin (n + 1) := ⟨i.val, by omega⟩
        simpa only [show k.castSucc = i from Fin.ext rfl, show k.succ = j from Fin.ext hij] using
          adjacent_braid_relation X n k
    · exact distant_braid_commute X n i j hij

/-- All standard symmetric-group relation words act trivially for a
self-transparent object. -/
theorem typeARelations_action_trivial {X : C}
    (hX : SelfTransparent X) (n : ℕ) :
    typeANormal n ≤ (FreeGroup.lift (braidGenerator X n)).ker :=
  show Subgroup.normalClosure (squareRelations n ∪ braidRelations n) ≤ _ from
    (Subgroup.normalClosure_union (squareRelations n) (braidRelations n)).symm ▸
      sup_le (squareRelations_action_trivial hX n) (braidRelations_action_trivial X n)

/-- Swaps of two adjacent pairs satisfy the braid relation. -/
theorem swap_braid {α : Type*} [DecidableEq α] {a b c : α}
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) :
    Equiv.swap a b * Equiv.swap b c * Equiv.swap a b =
      Equiv.swap b c * Equiv.swap a b * Equiv.swap b c := by
  simpa only [swap_comm] using (swap_mul_swap_mul_swap hbc.symm hac.symm).trans
    ((swap_comm a c).trans (swap_mul_swap_mul_swap hab hac).symm)

variable {n : ℕ} {i j : Fin (n + 1)}

/-- Adjacent transpositions satisfy the braid relation. -/
theorem adjacentSwaps_braid (hij : i.val + 1 = j.val) :
    s i * s j * s i = s j * s i * s j := by
  simpa only [adjacentSwap, ← (show i.succ = j.castSucc from Fin.ext hij)] using
    swap_braid (a := i.castSucc) (b := i.succ) (c := j.succ)
      (ne_of_lt i.castSucc_lt_succ)
      (ne_of_lt (Fin.castSucc_lt_succ_iff.mpr (show i ≤ j from by omega)))
      (ne_of_lt (Fin.succ_lt_succ_iff.mpr (show i < j from by omega)))

/-- Distant adjacent transpositions commute. -/
theorem adjacentSwaps_commute (hij : i.val + 1 < j.val) :
    s i * s j = s j * s i :=
  (Equiv.Perm.disjoint_swap_swap (by simp [Fin.ext_iff]; omega)).commute.eq

/-- Every defining type-A relation also has trivial strand permutation. -/
theorem typeARelations_permutation_trivial (n : ℕ) :
    typeANormal n ≤ (strandPermutation n).ker :=
  Subgroup.normalClosure_le_normal fun w hw ↦ MonoidHom.mem_ker.mpr <| by
    rcases hw with hw | hw
    · obtain ⟨i, rfl⟩ := hw
      exact Equiv.swap_mul_self _ _
    · rcases hw with ⟨i, j, hij, rfl⟩ | ⟨i, j, hij, rfl⟩ <;>
        simp only [strandPermutation, map_mul, map_inv, FreeGroup.lift_apply_of, mul_inv_eq_one]
      · exact adjacentSwaps_braid hij
      · exact adjacentSwaps_commute hij

end PropertyF.Ground.CentreCalculus

open CategoryTheory CategoryTheory.MonoidalCategory
namespace PropertyF.Ground.CentreCalculus
universe v u
variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [BraidedCategory C]

/-- A surjection identifies its kernel with a normal subgroup when the
quotient has at most as many elements as the codomain. -/
theorem ker_eq_of_card_quotient_le {G H : Type*} [Group G] [Group H]
    (f : G →* H) (N : Subgroup G) [N.Normal] [Finite (G ⧸ N)]
    (hN : N ≤ f.ker) (hf : Function.Surjective f) (hc : Nat.card (G ⧸ N) ≤ Nat.card H) :
    f.ker = N :=
  ((QuotientGroup.injective_lift_iff N f hN).mp
    ((QuotientGroup.lift_surjective_of_surjective N f hf hN).bijective_of_nat_card_le hc).1).symm

variable (n : ℕ)

/-- The group presented by adjacent involutions with type-A relations. -/
abbrev typeAGroup := BraidWords n ⧸ typeANormal n

/-- A finite normal-form bound of at most `(n+2)!` proves the presentation. -/
theorem pureWords_eq_typeANormal_of_card_bound [Finite (typeAGroup n)]
    (hcard : Nat.card (typeAGroup n) ≤ Nat.factorial (n + 2)) :
    (strandPermutation n).ker = typeANormal n :=
  ker_eq_of_card_quotient_le (strandPermutation n) (typeANormal n)
    (typeARelations_permutation_trivial n) (strandPermutation_surjective n)
    (by simpa [Nat.card_eq_fintype_card, Fintype.card_perm] using hcard)

end PropertyF.Ground.CentreCalculus

open CategoryTheory CategoryTheory.MonoidalCategory
namespace PropertyF.Ground.CentreCalculus
universe v u
variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [BraidedCategory C]

/-- The generators of the type-A quotient, padded by identity beyond their range. -/
def typeAGenerator (n i : ℕ) : typeAGroup n :=
  if h : i < n + 1 then QuotientGroup.mk' (typeANormal n) (FreeGroup.of ⟨i, h⟩) else 1

local notation "g" => typeAGenerator

variable {n : ℕ}

/-- Each type-A quotient generator is an involution. -/
theorem typeAGenerator_square {i : Fin (n + 1)} :
    g n i.val * g n i.val = 1 := by
  simpa [typeAGenerator, i.isLt, pow_two] using (QuotientGroup.eq_one_iff
    (N := typeANormal n) _).mpr (Subgroup.subset_normalClosure (Or.inl ⟨i, rfl⟩))

/-- Adjacent type-A quotient generators satisfy the braid relation. -/
theorem typeAGenerator_adjacent {i : Fin n} :
    g n i.val * g n (i.val + 1) * g n i.val =
      g n (i.val + 1) * g n i.val * g n (i.val + 1) := by
  simp [typeAGenerator, i.isLt, Nat.lt_succ_of_lt i.isLt, -map_mul]
  exact eq_iff_div_mem.mpr (subset_normalClosure (Or.inr (Or.inl ⟨i.castSucc, i.succ, rfl, rfl⟩)))

/-- Distant type-A quotient generators commute. -/
theorem typeAGenerator_distant {i j : Fin (n + 1)} (hij : i.val + 1 < j.val) :
    g n i.val * g n j.val = g n j.val * g n i.val := by
  simp only [typeAGenerator, dite_eq_left i.isLt, dite_eq_left j.isLt, ← map_mul]
  exact eq_iff_div_mem.mpr (subset_normalClosure (Or.inr (Or.inr ⟨i, j, hij, rfl⟩)))

variable (n : ℕ)

/-- The quotient is generated by its adjacent generators. -/
theorem typeAGenerator_generates :
    Subgroup.closure (Set.range (fun i : Fin (n + 1) => g n i.val)) = ⊤ :=
  FreeGroup.lift_surjective_iff_closure_range_eq_top.mp <|
    (FreeGroup.ext_hom (FreeGroup.lift fun i : Fin (n + 1) ↦ g n i.val)
      (QuotientGroup.mk' (typeANormal n)) fun i ↦ by
        simp only [FreeGroup.lift_apply_of, typeAGenerator, dite_eq_left i.isLt]).symm ▸
        QuotientGroup.mk'_surjective (typeANormal n)

/-- The quotient generators satisfy the type-A relations. -/
theorem typeAGenerator_isTypeAFamily : IsTypeAFamily (g n) (n + 1) :=
  ⟨fun i hi ↦ typeAGenerator_square (i := ⟨i, hi⟩),
    fun i hi ↦ typeAGenerator_adjacent (i := ⟨i, by omega⟩),
    fun i j hij hj ↦ typeAGenerator_distant (i := ⟨i, by omega⟩) (j := ⟨j, hj⟩) hij⟩

/-- The type-A presentation has exactly enough elements for the permutation
surjection to be an isomorphism. -/
theorem typeA_finite_card : Finite (typeAGroup n) ∧
    Nat.card (typeAGroup n) ≤ Nat.factorial (n + 2) :=
  finite_card_of_typeA (n + 1) (g n) (typeAGenerator_isTypeAFamily n) (typeAGenerator_generates n)

/-- The kernel of the strand permutation is exactly the normal subgroup
generated by the type-A relations. -/
theorem pureWords_eq_typeANormal :
    (strandPermutation n).ker = typeANormal n :=
  let ⟨hf, hc⟩ := typeA_finite_card n
  let : Finite (typeAGroup n) := hf
  pureWords_eq_typeANormal_of_card_bound n hc

/-- Self-transparent categorical braid actions factor through permutations. -/
def permAction (X : C)
    (hX : SelfTransparent X) (n : ℕ) :
    Perm (Fin (n + 2)) →* Aut (tensorPower X (n + 2)) :=
  permActionOfPureTrivial X n (by
    rw [pureWords_eq_typeANormal n]
    exact typeARelations_action_trivial hX n)

/-- The descended action sends adjacent swaps to the actual braid generators. -/
theorem permAction_swap {X : C}
    (hX : SelfTransparent X) {n : ℕ} (i : Fin (n + 1)) :
    permAction X hX n (adjacentSwap i) = braidGenerator X n i :=
  permActionOfPureTrivial_swap X n _ i

end PropertyF.Ground.CentreCalculus
