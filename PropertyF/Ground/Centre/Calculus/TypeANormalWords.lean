module
public import Mathlib.Tactic

/-! Normal-form identities for type-A generators in an arbitrary group. -/
@[expose] public noncomputable section
namespace PropertyF.Ground.CentreCalculus

variable {G : Type*} [Group G]

/-- A family of involutions satisfying the type-A braid and commutation relations. -/
structure IsTypeAFamily (s : ℕ → G) (m : ℕ) : Prop where
  square : ∀ i, i < m → s i * s i = 1
  braid : ∀ i, i + 1 < m → s i * s (i + 1) * s i = s (i + 1) * s i * s (i + 1)
  commute : ∀ i j, i + 1 < j → j < m → s i * s j = s j * s i

/-- Shifting a type-A family into a subgroup preserves its relations. -/
theorem IsTypeAFamily.shift {H : Subgroup G} {s : ℕ → G} {t : ℕ → H} {m : ℕ}
    (hrel : IsTypeAFamily s (m + 1))
    (ht : ∀ i, i < m → (t i : G) = s (i + 1)) : IsTypeAFamily t m :=
  ⟨fun i hi ↦ Subtype.ext <| by
    simpa only [Subgroup.coe_mul, Subgroup.coe_one, ht i hi] using hrel.square (i + 1) (by omega),
   fun i hi ↦ Subtype.ext <| by
    simpa only [Subgroup.coe_mul, ht i (by omega), ht (i + 1) (by omega), Nat.add_assoc] using
      hrel.braid (i + 1) (by omega),
   fun i j hij hj ↦ Subtype.ext <| by
    simpa only [Subgroup.coe_mul, ht i (by omega), ht j hj] using
      hrel.commute (i + 1) (j + 1) (by omega) (by omega)⟩

/-- The word moving strand zero through the first `j` adjacent positions. -/
def moveWord (s : ℕ → G) : ℕ → G
  | 0 => 1
  | j + 1 => s j * moveWord s j

/-- A generator beyond a word's support commutes with the word. -/
theorem commute_moveWord {s : ℕ → G} {m : ℕ}
    (hc : ∀ i j, i + 1 < j → j < m → s i * s j = s j * s i)
    (i : ℕ) : ∀ j, j + 1 ≤ i → i < m →
      s i * moveWord s j = moveWord s j * s i := by
  intro j
  induction j with
  | zero => exact fun _ _ ↦ (mul_one _).trans (one_mul _).symm
  | succ j ih =>
    intro hji him
    simp only [moveWord, ← mul_assoc]
    rw [(hc j i (by omega) him).symm, mul_assoc, ih (by omega) him, ← mul_assoc]

/-- Moving a crossing past the strand-moving word shifts its index by one.
This is the main rewriting step for the type-A coset normal form. -/
theorem moveWord_exchange {s : ℕ → G} {m : ℕ}
    (hb : ∀ i, i + 1 < m → s i * s (i + 1) * s i = s (i + 1) * s i * s (i + 1))
    (hc : ∀ i j, i + 1 < j → j < m → s i * s j = s j * s i) :
    ∀ j i, i + 1 < j → j ≤ m →
      s i * moveWord s j = moveWord s j * s (i + 1) := by
  intro j
  induction j with
  | zero => intro i hi; omega
  | succ j ih =>
    intro i hij hjm
    by_cases h : i + 1 = j
    · subst j
      have hcomm := commute_moveWord hc (i + 1) i (by omega) (by omega)
      simp only [moveWord]
      rw [← mul_assoc, ← mul_assoc, hb i (by omega)]
      simp only [mul_assoc, hcomm]
    · simp only [moveWord]
      rw [← mul_assoc, hc i j (by omega) (by omega), mul_assoc,
        ih i (by omega) (by omega), ← mul_assoc]

end PropertyF.Ground.CentreCalculus

namespace PropertyF.Ground.CentreCalculus
variable {G : Type*} [Group G]

variable {s : ℕ → G} {m : ℕ} (hrel : IsTypeAFamily s m)

include hrel in
/-- One generator sends each standard coset representative to another,
up to a generator from the shifted parabolic subgroup. -/
theorem moveWord_coset_step {i j : ℕ} (hi : i < m) (hj : j ≤ m) :
    ∃ k ≤ m, ∃ h ∈ Subgroup.closure (Set.range (fun t : Fin (m - 1) => s (t.val + 1))),
      s i * moveWord s j = moveWord s k * h := by
  let H := Subgroup.closure (Set.range (fun t : Fin (m - 1) => s (t.val + 1)))
  have memH (a : ℕ) (ha : 0 < a) (ham : a < m) : s a ∈ H :=
    Subgroup.subset_closure ⟨⟨a - 1, by omega⟩, congrArg s (Nat.sub_add_cancel (by omega))⟩
  by_cases h₁ : i + 1 < j
  · exact ⟨j, hj, s (i + 1), memH _ (by omega) (by omega),
      moveWord_exchange hrel.braid hrel.commute j i h₁ hj⟩
  · by_cases h₂ : j = i + 1
    · subst j
      refine ⟨i, by omega, 1, H.one_mem, ?_⟩
      simp only [moveWord, mul_one, ← mul_assoc, hrel.square i hi, one_mul]
    · by_cases h₃ : j = i
      · subst j
        refine ⟨i + 1, by omega, 1, H.one_mem, ?_⟩
        simp [moveWord]
      · exact ⟨j, hj, s i, memH _ (by omega) hi,
          commute_moveWord hrel.commute i j (by omega) hi⟩

include hrel in
/-- Every word in type-A generators has one of `m+1` standard left coset
representatives modulo the subgroup generated by positions `1,...,m-1`. -/
theorem exists_moveWord_coset {g : G} (hg : g ∈ Subgroup.closure (Set.range (fun t : Fin m => s t.val))) :
    ∃ j ≤ m, ∃ h ∈ Subgroup.closure (Set.range (fun t : Fin (m - 1) => s (t.val + 1))),
      g = moveWord s j * h := by
  let H := Subgroup.closure (Set.range (fun t : Fin (m - 1) => s (t.val + 1)))
  have step : ∀ (i : Fin m) (g : G),
      (∃ j ≤ m, ∃ h ∈ H, g = moveWord s j * h) →
      ∃ j ≤ m, ∃ h ∈ H, s i.val * g = moveWord s j * h := by
    intro i g hg
    obtain ⟨j, hj, h, hh, he⟩ := hg
    rw [he]
    obtain ⟨k, hk, h', hh', heq⟩ := moveWord_coset_step hrel i.isLt hj
    refine ⟨k, hk, h' * h, H.mul_mem hh' hh, ?_⟩
    rw [← mul_assoc, heq, mul_assoc]
  induction hg using Subgroup.closure_induction_left with
  | one => exact ⟨0, Nat.zero_le _, 1, H.one_mem, by simp [moveWord]⟩
  | mul_left x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hx
    exact step i y ih
  | inv_mul_cancel x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hx
    rw [inv_eq_of_mul_eq_one_left (hrel.square i.val i.isLt)]
    exact step i y ih

end PropertyF.Ground.CentreCalculus

namespace PropertyF.Ground.CentreCalculus
variable {G : Type*} [Group G]

/-- A group generated by `m` type-A involutions is finite of order at most
`(m+1)!`. The proof uses the explicit parabolic coset normal form. -/
theorem finite_card_of_typeA (m : ℕ) : ∀ {G : Type*} [Group G] (s : ℕ → G),
    IsTypeAFamily s m →
    Subgroup.closure (Set.range (fun t : Fin m => s t.val)) = ⊤ →
    Finite G ∧ Nat.card G ≤ Nat.factorial (m + 1) := by
  induction m with
  | zero =>
    intro G inst s _ hgen
    have htop : (⊥ : Subgroup G) = ⊤ := by simpa using hgen
    let : Subsingleton G := Subgroup.subsingleton_iff.mp (subsingleton_iff_bot_eq_top.mp htop)
    have : Finite G := Finite.of_subsingleton
    exact ⟨inferInstance, by simp [Nat.card_unique]⟩
  | succ m ih =>
    intro G inst s hrel hgen
    let H := Subgroup.closure (Set.range (fun t : Fin m => s (t.val + 1)))
    let t : ℕ → H := fun i => if h : i < m then
      ⟨s (i + 1), Subgroup.subset_closure ⟨⟨i, h⟩, rfl⟩⟩ else 1
    have ht (i : ℕ) (hi : i < m) : (t i : G) = s (i + 1) := by simp [t, hi]
    have htgen : Subgroup.closure (Set.range (fun q : Fin m => t q.val)) = ⊤ := by
      apply Subgroup.map_injective H.subtype_injective
      simp only [MonoidHom.map_closure, Subgroup.map_top, Subgroup.range_subtype]
      congr 1
      rw [← Set.range_comp]
      congr 1
      exact funext fun q ↦ ht q.val q.isLt
    obtain ⟨hfin, hcard⟩ := ih t (hrel.shift ht) htgen
    let : Finite H := hfin
    let f : Fin (m + 2) × H → G := fun a => moveWord s a.1.val * a.2
    have hf : Function.Surjective f := by
      intro g
      have hg : g ∈ Subgroup.closure (Set.range (fun q : Fin (m + 1) => s q.val)) := by rw [hgen]; trivial
      obtain ⟨j, hj, h, hh, he⟩ := exists_moveWord_coset hrel hg
      exact ⟨(⟨j, by omega⟩, ⟨h, by simpa [H] using hh⟩), he.symm⟩
    let : Finite G := Finite.of_surjective f hf
    refine ⟨inferInstance, ?_⟩
    calc
      Nat.card G ≤ Nat.card (Fin (m + 2) × H) := Nat.card_le_card_of_surjective f hf
      _ = (m + 2) * Nat.card H := by simp [Nat.card_prod]
      _ ≤ (m + 2) * Nat.factorial (m + 1) := Nat.mul_le_mul_left _ hcard
      _ = Nat.factorial (m + 1 + 1) := by simp [Nat.factorial_succ]

end PropertyF.Ground.CentreCalculus
