module
public import Mathlib.Tactic

/-! Normal-form identities for type-A generators in an arbitrary group. -/
@[expose] public noncomputable section
namespace PropertyF.Ground.CentreCalculus

variable {G : Type*} [Group G]

/-- The word moving strand zero through the first `j` adjacent positions. -/
def moveWord (s : ℕ → G) : ℕ → G
  | 0 => 1
  | j + 1 => s j * moveWord s j

/-- A generator beyond a word's support commutes with the word. -/
theorem commute_moveWord (s : ℕ → G) (m : ℕ)
    (hc : ∀ i j, i + 1 < j → j < m → s i * s j = s j * s i)
    (i : ℕ) : ∀ j, j + 1 ≤ i → i < m →
      s i * moveWord s j = moveWord s j * s i := by
  intro j
  induction j with
  | zero => simp [moveWord]
  | succ j ih =>
    intro hji him
    have hcomm := (hc j i (by omega) him).symm
    simp only [moveWord, ← mul_assoc]
    rw [hcomm, mul_assoc, ih (by omega) him, ← mul_assoc]

/-- Moving a crossing past the strand-moving word shifts its index by one.
This is the main rewriting step for the type-A coset normal form. -/
theorem moveWord_exchange (s : ℕ → G) (m : ℕ)
    (hb : ∀ i, i + 1 < m → s i * s (i + 1) * s i = s (i + 1) * s i * s (i + 1))
    (hc : ∀ i j, i + 1 < j → j < m → s i * s j = s j * s i) :
    ∀ j i, i + 1 < j → j ≤ m →
      s i * moveWord s j = moveWord s j * s (i + 1) := by
  intro j
  induction j with
  | zero => intro i hi; omega
  | succ j ih =>
    intro i hij hjm
    by_cases h : i + 1 = j
    · subst j
      have hcomm := commute_moveWord s m hc (i + 1) i (by omega) (by omega)
      simp only [moveWord]
      calc
        s i * (s (i + 1) * (s i * moveWord s i)) =
            (s i * s (i + 1) * s i) * moveWord s i := by simp [mul_assoc]
        _ = (s (i + 1) * s i * s (i + 1)) * moveWord s i := by rw [hb i (by omega)]
        _ = s (i + 1) * (s i * moveWord s i) * s (i + 1) := by
          simp only [mul_assoc]
          rw [hcomm]
    · have hc' := hc i j (by omega) (by omega)
      simp only [moveWord]
      calc
        s i * (s j * moveWord s j) = s j * (s i * moveWord s j) := by rw [← mul_assoc, hc', mul_assoc]
        _ = s j * (moveWord s j * s (i + 1)) := by rw [ih i (by omega) (by omega)]
        _ = s j * moveWord s j * s (i + 1) := by simp [mul_assoc]

end PropertyF.Ground.CentreCalculus

namespace PropertyF.Ground.CentreCalculus
variable {G : Type*} [Group G]

/-- One generator sends each standard coset representative to another,
up to a generator from the shifted parabolic subgroup. -/
theorem moveWord_coset_step (s : ℕ → G) (m : ℕ)
    (hs : ∀ i, i < m → s i * s i = 1)
    (hb : ∀ i, i + 1 < m → s i * s (i + 1) * s i = s (i + 1) * s i * s (i + 1))
    (hc : ∀ i j, i + 1 < j → j < m → s i * s j = s j * s i)
    (i j : ℕ) (hi : i < m) (hj : j ≤ m) :
    ∃ k ≤ m, ∃ h ∈ Subgroup.closure (Set.range (fun t : Fin (m - 1) => s (t.val + 1))),
      s i * moveWord s j = moveWord s k * h := by
  let H := Subgroup.closure (Set.range (fun t : Fin (m - 1) => s (t.val + 1)))
  have memH (a : ℕ) (ha : 0 < a) (ham : a < m) : s a ∈ H := by
    apply Subgroup.subset_closure
    refine ⟨⟨a - 1, by omega⟩, ?_⟩
    change s (a - 1 + 1) = s a
    congr 1
    omega
  by_cases h₁ : i + 1 < j
  · refine ⟨j, hj, s (i + 1), memH _ (by omega) (by omega), ?_⟩
    exact moveWord_exchange s m hb hc j i h₁ hj
  · by_cases h₂ : j = i + 1
    · subst j
      refine ⟨i, by omega, 1, H.one_mem, ?_⟩
      simp only [moveWord, mul_one, ← mul_assoc, hs i hi, one_mul]
    · by_cases h₃ : j = i
      · subst j
        refine ⟨i + 1, by omega, 1, H.one_mem, ?_⟩
        simp [moveWord]
      · have hji : j + 1 ≤ i := by omega
        refine ⟨j, hj, s i, memH _ (by omega) hi, ?_⟩
        exact commute_moveWord s m hc i j hji hi

end PropertyF.Ground.CentreCalculus

namespace PropertyF.Ground.CentreCalculus
variable {G : Type*} [Group G]

/-- Every word in type-A generators has one of `m+1` standard left coset
representatives modulo the subgroup generated by positions `1,...,m-1`. -/
theorem exists_moveWord_coset (s : ℕ → G) (m : ℕ)
    (hs : ∀ i, i < m → s i * s i = 1)
    (hb : ∀ i, i + 1 < m → s i * s (i + 1) * s i = s (i + 1) * s i * s (i + 1))
    (hc : ∀ i j, i + 1 < j → j < m → s i * s j = s j * s i)
    (g : G) (hg : g ∈ Subgroup.closure (Set.range (fun t : Fin m => s t.val))) :
    ∃ j ≤ m, ∃ h ∈ Subgroup.closure (Set.range (fun t : Fin (m - 1) => s (t.val + 1))),
      g = moveWord s j * h := by
  let H := Subgroup.closure (Set.range (fun t : Fin (m - 1) => s (t.val + 1)))
  have step : ∀ (i : Fin m) (g : G),
      (∃ j ≤ m, ∃ h ∈ H, g = moveWord s j * h) →
      ∃ j ≤ m, ∃ h ∈ H, s i.val * g = moveWord s j * h := by
    intro i g hg
    obtain ⟨j, hj, h, hh, he⟩ := hg
    rw [he]
    obtain ⟨k, hk, h', hh', heq⟩ := moveWord_coset_step s m hs hb hc i.val j i.isLt hj
    refine ⟨k, hk, h' * h, H.mul_mem hh' hh, ?_⟩
    rw [← mul_assoc, heq, mul_assoc]
  induction hg using Subgroup.closure_induction_left with
  | one => exact ⟨0, Nat.zero_le _, 1, H.one_mem, by simp [moveWord]⟩
  | mul_left x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hx
    exact step i y ih
  | inv_mul_cancel x hx y hy ih =>
    obtain ⟨i, rfl⟩ := hx
    have hinv : (s i.val)⁻¹ = s i.val := by
      apply inv_eq_of_mul_eq_one_left
      exact hs i.val i.isLt
    rw [hinv]
    exact step i y ih

end PropertyF.Ground.CentreCalculus

namespace PropertyF.Ground.CentreCalculus
variable {G : Type*} [Group G]

/-- A group generated by `m` type-A involutions is finite of order at most
`(m+1)!`. The proof uses the explicit parabolic coset normal form. -/
theorem finite_card_of_typeA (m : ℕ) : ∀ {G : Type*} [Group G] (s : ℕ → G),
    (∀ i, i < m → s i * s i = 1) →
    (∀ i, i + 1 < m → s i * s (i + 1) * s i = s (i + 1) * s i * s (i + 1)) →
    (∀ i j, i + 1 < j → j < m → s i * s j = s j * s i) →
    Subgroup.closure (Set.range (fun t : Fin m => s t.val)) = ⊤ →
    Finite G ∧ Nat.card G ≤ Nat.factorial (m + 1) := by
  induction m with
  | zero =>
    intro G inst s hs hb hc hgen
    have hbot : Subgroup.closure (Set.range (fun t : Fin 0 => s t.val)) = ⊥ := by simp
    have htop : (⊥ : Subgroup G) = ⊤ := hbot.symm.trans hgen
    have htriv (g : G) : g = 1 := by
      have hg : g ∈ (⊥ : Subgroup G) := by rw [htop]; trivial
      simpa using hg
    letI : Subsingleton G := ⟨fun a b => (htriv a).trans (htriv b).symm⟩
    haveI : Finite G := Finite.of_subsingleton
    refine ⟨inferInstance, ?_⟩
    simp [Nat.card_unique]
  | succ m ih =>
    intro G inst s hs hb hc hgen
    let H := Subgroup.closure (Set.range (fun t : Fin m => s (t.val + 1)))
    let t : ℕ → H := fun i => if h : i < m then
      ⟨s (i + 1), Subgroup.subset_closure ⟨⟨i, h⟩, rfl⟩⟩ else 1
    have ht (i : ℕ) (hi : i < m) : (t i : G) = s (i + 1) := by simp [t, hi]
    have hts : ∀ i, i < m → t i * t i = 1 := by
      intro i hi
      apply Subtype.ext
      change (t i : G) * (t i : G) = 1
      rw [ht i hi]
      exact hs (i + 1) (by omega)
    have htb : ∀ i, i + 1 < m → t i * t (i + 1) * t i = t (i + 1) * t i * t (i + 1) := by
      intro i hi
      apply Subtype.ext
      change (t i : G) * (t (i + 1) : G) * (t i : G) =
        (t (i + 1) : G) * (t i : G) * (t (i + 1) : G)
      rw [ht i (by omega), ht (i + 1) (by omega)]
      simpa only [Nat.add_assoc] using hb (i + 1) (by omega)
    have htc : ∀ i j, i + 1 < j → j < m → t i * t j = t j * t i := by
      intro i j hij hj
      apply Subtype.ext
      change (t i : G) * (t j : G) = (t j : G) * (t i : G)
      rw [ht i (by omega), ht j hj]
      exact hc (i + 1) (j + 1) (by omega) (by omega)
    have htgen : Subgroup.closure (Set.range (fun q : Fin m => t q.val)) = ⊤ := by
      let K := Subgroup.closure (Set.range (fun q : Fin m => t q.val))
      have himage : H.subtype '' (Set.range (fun q : Fin m => t q.val)) =
          Set.range (fun q : Fin m => s (q.val + 1)) := by
        ext x
        simp only [Set.mem_image, Set.mem_range]
        constructor
        · rintro ⟨_, ⟨q, rfl⟩, rfl⟩
          exact ⟨q, (ht q.val q.isLt).symm⟩
        · rintro ⟨q, rfl⟩
          exact ⟨t q.val, ⟨q, rfl⟩, ht q.val q.isLt⟩
      have hmap : K.map H.subtype = H := by
        rw [MonoidHom.map_closure, himage]
      apply top_unique
      intro h _
      have hh : (h : G) ∈ K.map H.subtype := by rw [hmap]; exact h.property
      obtain ⟨h', hh', he⟩ := hh
      have he' : h' = h := Subtype.ext he
      simpa [he', K] using hh'
    obtain ⟨hfin, hcard⟩ := ih t hts htb htc htgen
    letI : Finite H := hfin
    letI : Fintype H := Fintype.ofFinite H
    let f : Fin (m + 2) × H → G := fun a => moveWord s a.1.val * a.2
    have hf : Function.Surjective f := by
      intro g
      have hg : g ∈ Subgroup.closure (Set.range (fun q : Fin (m + 1) => s q.val)) := by rw [hgen]; trivial
      obtain ⟨j, hj, h, hh, he⟩ := exists_moveWord_coset s (m + 1) hs hb hc g hg
      refine ⟨(⟨j, by omega⟩, ⟨h, by simpa [H] using hh⟩), ?_⟩
      exact he.symm
    letI : Finite G := Finite.of_surjective f hf
    letI : Fintype G := Fintype.ofFinite G
    refine ⟨inferInstance, ?_⟩
    have hle := Fintype.card_le_of_surjective f hf
    simp only [Fintype.card_prod, Fintype.card_fin] at hle
    rw [Nat.card_eq_fintype_card] at hcard ⊢
    have hfac : Nat.factorial (m + 1 + 1) = (m + 2) * Nat.factorial (m + 1) := by simp [Nat.factorial_succ]
    rw [hfac]
    exact hle.trans (Nat.mul_le_mul_left _ hcard)

end PropertyF.Ground.CentreCalculus
