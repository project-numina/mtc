module
public import PropertyF.Ground.Fusion.GeneratedRigidity
public import PropertyF.Ground.Fusion.SemisimpleSplit
public import PropertyF.Ground.Fusion.FunctorDimension
public import Mathlib.CategoryTheory.Linear.LinearFunctor

/-! Structures inherited by the tensor subcategory generated by an object. -/

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.MonoidalCategory CategoryTheory.Limits
namespace PropertyF.Ground
universe v u
attribute [local instance] Abelian.hasFiniteBiproducts

/-- The generated full subcategory is abelian. -/
@[instance_reducible] def generatedCategoryAbelian (D : BraidedFusionCategory.{v,u})
    (X : D.Obj) : Abelian (generatedCategory X) :=
  generatedCategoryAbelianOfSplit X
    (fun f hf => by letI := hf; exact mono_splits D f)
    (fun f hf => by letI := hf; exact epi_splits D f)

/-- The generated full subcategory has the fusion finiteness properties. -/
@[instance_reducible] def generatedCategoryFusion (D : BraidedFusionCategory.{v,u}) (X : D.Obj) :
    letI := generatedCategoryAbelian D X
    letI := generatedCategoryRigid D X
    IsFusionCategory (generatedCategory X) := by
  classical
  letI := generatedCategoryAbelian D X
  letI := generatedCategoryRigid D X
  let F := generatedInclusion X
  letI : ObjectProperty.IsClosedUnderSubobjects (GeneratedBy X) := {
    prop_of_mono := by
      intro A B f hf hB
      letI : Mono f := hf
      letI : IsSplitMono f := mono_splits D f
      exact generatedBy_retract hB { i := f, r := retraction f }
  }
  letI : F.PreservesMonomorphisms :=
    ObjectProperty.preservesMonomorphisms_ι_of_isNormalEpiCategory (GeneratedBy X)
  let P : Fin (rank D) → Prop := fun i => GeneratedBy X (simples D i)
  let I := { i : Fin (rank D) // P i }
  let n := Fintype.card I
  let ei : I ≃ Fin n := Fintype.equivFin I
  let S : Fin n → generatedCategory X := fun i => ⟨simples D (ei.symm i).1, (ei.symm i).2⟩
  refine { hom_finite := ?_, unit_simple := ?_, finite_semisimple := ?_ }
  · intro A B
    letI : FiniteDimensional ℂ (F.obj A ⟶ F.obj B) := IsFusionCategory.hom_finite _ _
    exact FiniteDimensional.of_injective (F.mapLinearMap ℂ) F.map_injective
  · letI : Simple (F.obj (𝟙_ (generatedCategory X))) := by
      change Simple (𝟙_ D.Obj)
      exact IsFusionCategory.unit_simple
    exact Functor.simple_of_simple_obj F _
  · refine ⟨n, S, ?_, ?_, ?_⟩
    · intro i
      letI : Simple (F.obj (S i)) := simples_simple D (ei.symm i).1
      exact Functor.simple_of_simple_obj F _
    · intro i j ⟨e⟩
      apply ei.symm.injective
      apply Subtype.ext
      exact simples_injective D _ _ ⟨F.mapIso e⟩
    · intro Y
      obtain ⟨m, ⟨e⟩⟩ := simples_decompose D Y.obj
      let V : (Σ i, Fin (m i)) → D.Obj := fun p => simples D p.1
      have hV (p : Σ i, Fin (m i)) : P p.1 := by
        apply generatedBy_retract Y.property
        exact { i := biproduct.ι V p ≫ e.inv
                r := e.hom ≫ biproduct.π V p
                retract := by simpa [V, Category.assoc] }
      let m' : Fin n → ℕ := fun i => m (ei.symm i).1
      let idx : (Σ i, Fin (m i)) → (Σ j, Fin (m' j)) :=
        fun p => ⟨ei ⟨p.1, hV p⟩, ⟨p.2.val, by simpa [m'] using p.2.isLt⟩⟩
      let idxInv : (Σ j, Fin (m' j)) → (Σ i, Fin (m i)) :=
        fun p => ⟨(ei.symm p.1).1, p.2⟩
      have hinv : Function.LeftInverse idxInv idx := by
        intro p
        cases p
        simp [idx, idxInv, m']
        apply (Fin.heq_ext_iff (by simp [idx, idxInv, m'])).mpr
        rfl
      have hinv' : Function.RightInverse idxInv idx := by
        intro p
        cases p with
        | mk a b =>
          have hs : (⟨(ei.symm a).1, hV (idxInv ⟨a, b⟩)⟩ : I) = ei.symm a := Subtype.ext rfl
          simp [idx, idxInv, m', hs]
          apply (Fin.heq_ext_iff (by simp [idx, idxInv, m', hs])).mpr
          rfl
      let ee : (Σ i, Fin (m i)) ≃ (Σ j, Fin (m' j)) := ⟨idx, idxInv, hinv, hinv'⟩
      let W : (Σ j, Fin (m' j)) → generatedCategory X := fun p => S p.1
      let ev : (⨁ V) ≅ ⨁ (fun p => F.obj (W p)) :=
        biproduct.whiskerEquiv ee (fun p => eqToIso (by change _ = _; simp [F, V, W, S, idx, ee, generatedInclusion]))
      let ey : F.obj Y ≅ F.obj (⨁ W) := e ≪≫ ev ≪≫ (F.mapBiproduct W).symm
      exact ⟨m', ⟨F.preimageIso ey⟩⟩

/-- The actual fusion subcategory generated by an arbitrary object. -/
def generatedFusionCategory (D : BraidedFusionCategory.{v,u})
    (X : D.Obj) : BraidedFusionCategory.{v,u} := by
  letI := generatedCategoryAbelian D X
  letI := generatedCategoryRigid D X
  letI := generatedCategoryFusion D X
  exact { Obj := generatedCategory X }


end PropertyF.Ground
