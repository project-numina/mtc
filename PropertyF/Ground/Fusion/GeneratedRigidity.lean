module
public import PropertyF.Ground.Fusion.UnitPower
public import PropertyF.Ground.Cabling.UnitPower

/-! The subcategory generated by a simple object is closed under duals. -/

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.MonoidalCategory
namespace PropertyF.Ground
universe v u

/-- The right dual of a simple object lies in its generated tensor closure. -/
theorem simple_generatedBy_rightDual (D : BraidedFusionCategory.{v,u})
    (X : D.Obj) [Simple X] : GeneratedBy X (Xᘁ) := by
  obtain ⟨n, ⟨r⟩⟩ := unit_retract_tensorPower D X
  exact Cabling.generatedBy_rightDual_of_unit_power D X n r

/-- The tensor subcategory generated by a simple object is rigid. -/
@[instance_reducible] def simple_generatedCategoryRigid (D : BraidedFusionCategory.{v,u})
    (X : D.Obj) [Simple X] : RigidCategory (generatedCategory X) :=
  generatedCategoryRigidOfGeneratorDual X (simple_generatedBy_rightDual D X)

end PropertyF.Ground
