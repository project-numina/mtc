module
public import PropertyF.Ground.Fusion.ObjectDimension
public import PropertyF.Ground.Fusion.GeneratedStructure
public import PropertyF.Ground.Integrate.ConjugateBound
public import PropertyF.Ground.Integrate.Arithmetic

/-! Weak integrality forces squares of simple FP dimensions to be integers. -/

@[expose] public noncomputable section
open CategoryTheory
open scoped BigOperators
namespace PropertyF.Ground
universe v u

/-- An integral real number fixed by every complex automorphism is an integer. -/
theorem integral_real_fixed_integer (x : ℝ) (hx : IsIntegral ℤ x)
    (hfixed : ∀ σ : ℂ ≃+* ℂ, σ (x : ℂ) = (x : ℂ)) : ∃ z : ℤ, x = z := by
  have hx' : IsIntegral ℤ (x : ℂ) :=
    (isIntegral_algebraMap_iff (R := ℤ) (A := ℝ) (B := ℂ)).mpr hx
  let K := Dimensions.dimensionNormalField (x : ℂ)
  have h := Dimensions.finite_galois_normal_field (x : ℂ) (hx'.tower_top (A := ℚ))
  letI : FiniteDimensional ℚ K := h.2.1
  letI : IsGalois ℚ K := h.2.2
  let y : K := ⟨(x : ℂ), h.1⟩
  have hy : IsIntegral ℤ y :=
    (isIntegral_algebraMap_iff (R := ℤ) (A := K) (B := ℂ)).mp (by simpa [y] using hx')
  have hyfix : ∀ σ : K ≃ₐ[ℚ] K, σ y = y := by
    intro σ
    obtain ⟨τ, hτ⟩ := Dimensions.extend_complex_automorphism K.toSubfield σ.toRingEquiv
    apply Subtype.ext
    calc
      (σ y : ℂ) = τ (y : ℂ) := (hτ y).symm
      _ = (y : ℂ) := hfixed τ
  obtain ⟨z, hz⟩ := integer_of_galois_fixed hy hyfix
  refine ⟨z, ?_⟩
  have hz' := congrArg (fun t : K => (t : ℂ)) hz
  simpa [y] using congrArg Complex.re hz'

/-- If the global FP dimension is an integer, every simple FP dimension has
integer square. This follows from Galois bounds and equality of the sums of
squares; no adjoint-component or legacy input is assumed. -/
theorem fpSimple_sq_integer_of_weaklyIntegral (C : BraidedFusionCategory.{v,u})
    (hweak : WeaklyIntegral (globalFPDimension C)) (i : Fin (rank C)) :
    ∃ z : ℤ, fpSimple C i ^ 2 = z := by
  classical
  let χ : Fin (rank C) → ℂ := fun i => (fpSimple C i : ℂ)
  have hunit : χ (unitIndex C) = 1 := by simp [χ, fpSimple_unit]
  have hchar : ∀ j k, χ j * χ k = ∑ l, (fusionCoeff C j k l : ℂ) * χ l := by
    intro j k
    simpa [χ] using congrArg (fun r : ℝ => (r : ℂ)) (fpSimple_mul C j k)
  have hdual : ∀ j, χ (dualIndex C j) = χ j := by simp [χ, fpSimple_dual]
  apply integral_real_fixed_integer _ ((fpSimple_isIntegral C i).pow 2)
  intro σ
  have hreal (j : Fin (rank C)) : (((σ (χ j)).re : ℝ) : ℂ) = σ (χ j) := by
    apply Complex.conj_eq_iff_re.mp
    simpa only [← Complex.star_def] using
      selfDual_character_galois_real C χ (unitIndex C) (by rw [hunit]; exact one_ne_zero)
        hchar hdual σ j
  let d : Fin (rank C) → ℝ := fun j => (σ (χ j)).re
  have hbound (j : Fin (rank C)) : |d j| ≤ fpSimple C j := by
    have h := Dimensions.galois_character_norm_le_fpSimple C χ (unitIndex C)
      (by rw [hunit]; exact one_ne_zero) hchar σ j
    rw [← hreal j] at h
    simpa [d, Complex.norm_real, Real.norm_eq_abs] using h
  obtain ⟨z, hz⟩ := hweak
  have hglobal : σ (globalFPDimension C : ℂ) = (globalFPDimension C : ℂ) := by
    rw [hz]
    simp
  have hsum : (∑ j, d j ^ 2) = globalFPDimension C := by
    apply Complex.ofReal_injective
    calc
      _ = ∑ j, σ (χ j) ^ 2 := by
        simp only [Complex.ofReal_sum, Complex.ofReal_pow]
        apply Finset.sum_congr rfl
        intro j _
        rw [hreal]
      _ = σ (globalFPDimension C : ℂ) := by
        simp [globalFPDimension, χ]
      _ = _ := hglobal
  have heq := (Dimensions.global_sum_squares_eq_iff C d hbound).mp hsum i
  have hsquare : d i ^ 2 = fpSimple C i ^ 2 := by
    rw [← sq_abs (d i), heq]
  change σ ((fpSimple C i ^ 2 : ℝ) : ℂ) = _
  rw [Complex.ofReal_pow, map_pow, ← hreal i, ← Complex.ofReal_pow, hsquare]
  simp

/-- The same square-integrality statement for any simple object. -/
theorem simple_fpDimension_sq_integer_of_weaklyIntegral
    (C : BraidedFusionCategory.{v,u}) (hweak : WeaklyIntegral (globalFPDimension C))
    (X : C.Obj) [Simple X] : ∃ z : ℤ, fpDimension C X ^ 2 = z := by
  obtain ⟨i, ⟨e⟩⟩ := exists_simple_iso C X
  rw [fpDimension_iso C e, fpDimension_simple]
  exact fpSimple_sq_integer_of_weaklyIntegral C hweak i

/-- Weak integrality of the fusion category generated by a simple object
forces the square of its ambient FP dimension to be an integer. -/
theorem generated_simple_square_integer (D : BraidedFusionCategory.{v,u})
    (X : D.Obj) [Simple X]
    (hweak : WeaklyIntegral (globalFPDimension (generatedFusionCategory D X))) :
    ∃ z : ℤ, fpDimension D X ^ 2 = z := by
  letI := generatedCategoryAbelian D X
  letI := generatedCategoryRigid D X
  letI := generatedCategoryFusion D X
  let F := generatedInclusion X
  letI : ObjectProperty.IsClosedUnderSubobjects (GeneratedBy X) := {
    prop_of_mono := by
      intro A B f hf hB
      letI : Mono f := hf
      letI : IsSplitMono f := mono_splits D f
      exact generatedBy_retract hB { i := f, r := retraction f }
  }
  letI : F.PreservesMonomorphisms :=
    ObjectProperty.preservesMonomorphisms_ι_of_isNormalEpiCategory (GeneratedBy X)
  let Y : (generatedFusionCategory D X).Obj := ⟨X, generatedBy_self X⟩
  letI : Simple (F.obj Y) := by
    change Simple X
    infer_instance
  letI : Simple Y := Functor.simple_of_simple_obj F Y
  obtain ⟨z, hz⟩ := simple_fpDimension_sq_integer_of_weaklyIntegral
    (generatedFusionCategory D X) hweak Y
  exact ⟨z, by simpa only [generatedFusionCategory_fpDimension] using hz⟩

end PropertyF.Ground
