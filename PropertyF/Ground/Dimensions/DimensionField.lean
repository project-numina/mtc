/-! # Fields of dimensions

Finite normal fields contain the algebraic values needed for dimension arguments.
-/

@[expose] public noncomputable section
open IntermediateField
namespace PropertyF.Ground.Dimensions

/-- Every automorphism of a subfield of ℂ extends to an automorphism of ℂ.
Choose a transcendence basis, apply the automorphism to coefficients while
fixing the basis, and extend across the algebraic closure. -/
theorem extend_complex_automorphism (K : Subfield ℂ) (σ : K ≃+* K) :
    ∃ τ : ℂ ≃+* ℂ, ∀ x : K, τ (x : ℂ) = (σ x : ℂ) := by
  obtain ⟨s, hs⟩ := exists_isTranscendenceBasis K ℂ
  let v : s → ℂ := fun x => x
  let A := Algebra.adjoin K (Set.range v)
  let e : MvPolynomial s K ≃ₐ[K] A := hs.1.aevalEquiv
  let α : A ≃+* A := e.toRingEquiv.symm.trans
    ((MvPolynomial.mapEquiv s σ).trans e.toRingEquiv)
  let : IsAlgClosure A ℂ := IsAlgClosed.isAlgClosure_of_transcendence_basis v hs
  let τ : ℂ ≃+* ℂ := IsAlgClosure.equivOfEquiv ℂ ℂ α
  refine ⟨τ, fun x => ?_⟩
  have hx : τ (algebraMap A ℂ (algebraMap K A x)) =
      algebraMap A ℂ (α (algebraMap K A x)) :=
    IsAlgClosure.equivOfEquiv_algebraMap ℂ ℂ α _
  have he : α (algebraMap K A x) = algebraMap K A (σ x) := by
    apply e.symm.injective
    simp [α, e]
  simpa [he, Subfield.algebraMap_ofSubfield] using hx

/-- The normal closure in the complex numbers of the field generated by `x`. -/
def dimensionNormalField (x : ℂ) : IntermediateField ℚ ℂ :=
  IntermediateField.normalClosure ℚ (IntermediateField.adjoin ℚ {x}) ℂ

/-- An algebraic complex number lies in a finite Galois intermediate field. -/
theorem finite_galois_normal_field (x : ℂ) (hx : IsIntegral ℚ x) :
    let K := dimensionNormalField x
    x ∈ K ∧ FiniteDimensional ℚ K ∧ IsGalois ℚ K := by
  let L := IntermediateField.adjoin ℚ {x}
  let K := dimensionNormalField x
  have hL : FiniteDimensional ℚ L :=
    IntermediateField.finiteDimensional_adjoin (by simpa using hx)
  let : FiniteDimensional ℚ L := hL
  have hsplit : ∀ y : L, ((minpoly ℚ y).map (algebraMap ℚ ℂ)).Splits := by
    intro y
    exact IsAlgClosed.splits _
  have hnormal : Normal ℚ K :=
    let : IsNormalClosure ℚ L K := Algebra.IsAlgebraic.isNormalClosure_normalClosure hsplit
    IsNormalClosure.normal (K := L)
  let : Normal ℚ K := hnormal
  have hgalois : IsGalois ℚ K := by
    let : FiniteDimensional ℚ K := normalClosure.is_finiteDimensional ℚ L ℂ
    exact { to_normal := hnormal }
  refine ⟨?_, ?_, hgalois⟩
  · exact IntermediateField.le_normalClosure L (IntermediateField.subset_adjoin ℚ {x} (by simp))
  · exact normalClosure.is_finiteDimensional ℚ L ℂ

end PropertyF.Ground.Dimensions
