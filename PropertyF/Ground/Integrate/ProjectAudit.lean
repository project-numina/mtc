/-! Scan all currently integrated project declarations, including the ground
modules. `PropertyF.Audit` alone sees only its own imports. -/

open Lean Elab Command in
run_cmd do
  let env ← getEnv
  let mut checked : Nat := 0
  for (name, _) in env.constants.toList do
    let projectModule := match env.getModuleIdxFor? name with
      | some idx => env.header.modules[idx.toNat]?.any fun m =>
          m.module.toString == "PropertyF" || m.module.toString.startsWith "PropertyF."
      | none => false
    if name.toString.startsWith "PropertyF." || projectModule then
      if Lean.isExtern env name || (Lean.Compiler.getImplementedBy? env name).isSome then
        throwError "Unexpected foreign implementation in project declaration {name}"
      for ax in ← collectAxioms name do
        unless #[``propext, ``Classical.choice, ``Quot.sound].contains ax do
          throwError "Unexpected axiom {ax} in project declaration {name}"
      checked := checked + 1
  logInfo m!"Audited {checked} integrated project declarations: no sorryAx or custom axioms."

private def auditFixture (n : Nat) : Nat := n

open Lean Elab Command PropertyF.Ground.DependencyAudit in
run_cmd do
  let env ← getEnv
  let modified ← match Lean.Compiler.setImplementedBy env
      ``auditFixture ``Nat.succ with
    | .ok env => pure env
    | .error err => throwError "could not create foreign-implementation test fixture: {err}"
  match findIssue modified ``auditFixture with
  | some (.foreignImplementation _) => pure ()
  | _ => throwError "dependency audit did not reject a substituted implementation"
  match findIssue env `PropertyF.Ground.AuditMissingFixture with
  | some (.missingDeclaration _) => pure ()
  | _ => throwError "dependency audit did not reject a missing declaration"
  match findIssue env ``PropertyF.Ground.DependencyAudit.hiddenInputWrapper with
  | some (.forbidden n) =>
      unless n == ``PropertyF.StandardInputs do
        throwError "unexpected forbidden fixture dependency {n}"
  | _ => throwError "dependency audit did not inspect an imported definition body"
  match findIssue env ``PropertyF.Ground.DependencyAudit.hiddenProof with
  | some (.forbidden n) =>
      unless n == ``PropertyF.StandardInputs do
        throwError "unexpected forbidden theorem fixture dependency {n}"
  | _ => throwError "dependency audit did not inspect the imported theorem proof"
  unless (findIssue env ``PropertyF.Ground.target_of_legacy_standardInputs).isSome do
    throwError "dependency audit did not reject the conditional target bridge"
  unless (findIssue env ``PropertyF.Ground.legacyCategory).isSome do
    throwError "dependency audit did not reject the old compatibility bundle"
  unless (findIssue env ``PropertyF.propertyF_implies_weaklyIntegral).isSome do
    throwError "dependency audit did not reject the imported conditional theorem"
  for n in #[``PropertyF.Ground.TargetStatement,
      ``PropertyF.Ground.unit_algebraMap_bijective,
      ``PropertyF.Ground.Example.complexVectorSpaces,
      ``PropertyF.Ground.Example.hasPseudoUnitaryGaloisConjugate,
      ``PropertyF.Ground.squaredNorm_eq_of_choices,
      ``PropertyF.Ground.Dimensions.target_globalDimension_independent_simples,
      ``PropertyF.Ground.simple_strand_inclusion,
      ``PropertyF.Ground.weaklyIntegral_of_globalFPDimension_fixed,
      ``PropertyF.Ground.galois_propertyF,
      ``PropertyF.Ground.target_of_galois_invariance_and_pseudo_fixedness,
      ``PropertyF.Ground.target_of_pseudo_fixedness,
      ``PropertyF.Ground.galois_fixed_of_smaller_conjugate_witness,
      ``PropertyF.Ground.positive_ratio_of_galois_square,
      ``PropertyF.Ground.center_witness_of_modular_and_rigidity,
      ``PropertyF.Ground.exists_modular_witness,
      ``PropertyF.Ground.center_witness_of_categorical_modular_data,
      ``PropertyF.Ground.propertyF_of_galois_column,
      ``PropertyF.Ground.galois_unit_self_entry,
      ``PropertyF.Ground.target_of_numerical_witnesses,
      ``PropertyF.Ground.target_of_bounded_conjugates_and_witness,
      ``PropertyF.Ground.target_of_spherical_and_witness,
      ``PropertyF.Ground.target_of_canonical_spherical_and_witness,
      ``PropertyF.Ground.target_of_canonical_spherical_and_center,
      ``PropertyF.Ground.Modular.conjugate_globalFPDimension,
      ``PropertyF.Ground.fpSimple_eq_fpCharacter,
      ``PropertyF.Ground.fpSimple_mul,
      ``PropertyF.Ground.globalFPDimension_presentation,
      ``PropertyF.Ground.generated_simple_square_integer,
      ``PropertyF.Ground.ScalarTwist.conjugate,
      ``PropertyF.Ground.ScalarTwist.labels,
      ``PropertyF.Ground.selfDual_character_galois_real,
      ``PropertyF.Ground.positive_bounded_conjugates_of_spherical,
      ``PropertyF.Ground.Calculus.exists_unitary_braid_trace_blocks,
      ``PropertyF.Ground.sum_simple_presentation,
      ``PropertyF.Ground.hasPseudoUnitaryGaloisConjugate_of_pseudoUnitary,
      ``PropertyF.Ground.Dimensions.squaredNorm_independent] do
    if let some issue := findIssue env n then
      throwError "dependency audit failed for ground result {n}: {repr issue}"
  logInfo "Dependency audit passed imported positive and negative fixtures."
