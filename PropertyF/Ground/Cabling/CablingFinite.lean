module
public import PropertyF.Ground.Cabling.TupleCrossing
public import PropertyF.Ground.Cabling.Naturality
open CategoryTheory CategoryTheory.MonoidalCategory CategoryTheory.Limits
open scoped BigOperators
@[expose] public noncomputable section
namespace PropertyF
universe v u
variable {C : Type u} [Category.{v} C] [MonoidalCategory C] [BraidedCategory C]
  [Abelian C] [MonoidalPreadditive C]
attribute [local instance] Abelian.hasFiniteBiproducts

/-- Property F supplies finite braid images for all strand counts. -/
theorem braidImageAll_finite_of_propertyF (X : C) (hX : ObjectPropertyF X) :
    ∀ m, Finite (braidImageAll X m)
  | 0 => by dsimp [braidImageAll]; infer_instance
  | 1 => by dsimp [braidImageAll]; infer_instance
  | m + 2 => hX m

/-- The pure-block cabling identity implies property F for a sum of powers,
using the proven permutation law and the finite-index pure image. -/
theorem objectPropertyF_sumPowers_of_block_membership (X : C) (hX : ObjectPropertyF X)
    (k : Fin count → ℕ)
    (hcable : ∀ (n : ℕ) (w : pureWords n) (t : Fin (n + 2) → Fin count),
      powerSumPureBlockAction X k n (powerSum_crossing_permutesBlocks X k n) w t ∈
        braidImageAllSubgroup X (∑ i, k (t i))) :
    ObjectPropertyF (⨁ fun i => tensorPower X (k i)) := by
  classical
  intro n
  let hgen := powerSum_crossing_permutesBlocks X k n
  let cable := powerSumCableAction X k n hgen (hcable n)
  let _ : ∀ t : Fin (n + 2) → Fin count, Finite (braidImageAll X (∑ i, k (t i))) :=
    fun t => braidImageAll_finite_of_propertyF X hX _
  let _ : Finite cable.range := Finite.of_injective cable.range.subtype Subtype.val_injective
  let f := pureWordAction (⨁ fun i => tensorPower X (k i)) n
  let hf := powerSumCableAction_ker_le X k n hgen (hcable n)
  let q := imageFactor cable f hf
  have hq : Function.Surjective q := by
    intro a
    obtain ⟨w, rfl⟩ := pureWordAction_surjective (⨁ fun i => tensorPower X (k i)) n a
    exact ⟨cable.rangeRestrict w, imageFactor_apply cable f hf w⟩
  have hp : Finite (pureBraidImage (⨁ fun i => tensorPower X (k i)) n) :=
    Finite.of_surjective q hq
  exact (Subgroup.finite_iff_finite_and_finiteIndex _).mpr ⟨hp, inferInstance⟩

/-- Once pure-block cabling is established for all sums of powers, property F
passes to every object generated by X. -/
theorem objectPropertyF_generated_of_block_membership (X : C) (hX : ObjectPropertyF X)
    (hcable : ∀ (count : ℕ) (k : Fin count → ℕ) (n : ℕ)
      (w : pureWords n) (t : Fin (n + 2) → Fin count),
      powerSumPureBlockAction X k n (powerSum_crossing_permutesBlocks X k n) w t ∈
        braidImageAllSubgroup X (∑ i, k (t i))) :
    ∀ Y, GeneratedBy X Y → ObjectPropertyF Y := by
  intro Y hY
  obtain ⟨count, k, ⟨r⟩⟩ := hY
  exact objectPropertyF_of_retract r (objectPropertyF_sumPowers_of_block_membership X hX k (hcable count k))
end PropertyF
