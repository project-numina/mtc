module
public import PropertyF.Ground.Cabling.GeneralDual
public import PropertyF.Ground.Cabling.GeneratedAbelian
public import PropertyF.Ground.Cabling.Inclusion
open CategoryTheory CategoryTheory.MonoidalCategory CategoryTheory.Limits
@[expose] public noncomputable section
namespace PropertyF.Ground.Cabling
universe v u
attribute [local instance] Abelian.hasFiniteBiproducts

/-- The fusion subcategory generated by an object, with its inherited braided structure. -/
def generatedFusion (D : Ground.BraidedFusionCategory.{v,u}) (X : D.Obj) :
    Ground.BraidedFusionCategory.{v,u} := by
  classical
  let E := generatedCategory X
  letI : Abelian E := generatedCategoryAbelian D X
  letI : RigidCategory E := generatedCategoryRigid D X
  let F : E ⥤ D.Obj := generatedInclusion X
  letI : ObjectProperty.IsClosedUnderSubobjects (GeneratedBy X) := {
    prop_of_mono := by
      intro A B f hf hB
      letI : Mono f := hf
      letI : IsSplitMono f := Ground.mono_splits D f
      exact generatedBy_retract hB { i := f, r := retraction f } }
  letI : F.PreservesMonomorphisms := by
    change (show ObjectProperty D.Obj from GeneratedBy X).ι.PreservesMonomorphisms
    exact ObjectProperty.preservesMonomorphisms_ι_of_isNormalEpiCategory _
  let T : Finset (Fin (rank D)) := Finset.univ.filter (fun i => GeneratedBy X (simples D i))
  let e : T ≃ Fin (Fintype.card T) := Fintype.equivFin T
  let idx : Fin (Fintype.card T) → Fin (rank D) := fun i => (e.symm i).1
  let S : Fin (Fintype.card T) → E := fun i => ⟨simples D (idx i), (e.symm i).2 |> Finset.mem_filter.mp |>.2⟩
  have hinj : Function.Injective idx := by
    intro i j h
    apply e.symm.injective
    apply Subtype.ext
    exact h
  have hs : ∀ i, Simple (S i) := by
    intro i
    have : Simple (F.obj (S i)) := Ground.simples_simple D (idx i)
    exact Functor.simple_of_simple_obj F _
  have hsinj : ∀ i j, Nonempty (S i ≅ S j) → i = j := by
    intro i j h
    apply hinj
    exact Ground.simples_injective D _ _ (h.map F.mapIso)
  have hfin : ∀ A : E, ∃ m : Fin (Fintype.card T) → ℕ,
      Nonempty (A ≅ ⨁ (fun p : Σ i, Fin (m i) => S p.1)) := by
    intro A
    obtain ⟨m, ⟨d⟩⟩ := Ground.simples_decompose D (F.obj A)
    let V : (Σ i, Fin (m i)) → D.Obj := fun p => simples D p.1
    have hgen (p : Σ i, Fin (m i)) : GeneratedBy X (simples D p.1) := by
      have r : Retract (V p) (F.obj A) :=
        (Retract.mk (biproduct.ι V p) (biproduct.π V p) (by simp)).trans (Retract.ofIso d.symm)
      exact generatedBy_retract A.property r
    let m' : Fin (Fintype.card T) → ℕ := fun i => m (idx i)
    let W : (Σ i, Fin (m' i)) → E := fun p => S p.1
    let f : (Σ i, Fin (m' i)) → (Σ i, Fin (m i)) := fun p => ⟨idx p.1, p.2⟩
    have hf : Function.Bijective f := by
      constructor
      · rintro ⟨i, a⟩ ⟨j, b⟩ h
        have hij : i = j := hinj (congrArg Sigma.fst h)
        subst j
        cases h
        rfl
      · rintro ⟨i, a⟩
        have hi : i ∈ T := Finset.mem_filter.mpr ⟨Finset.mem_univ _, hgen ⟨i, a⟩⟩
        let j : Fin (Fintype.card T) := e ⟨i, hi⟩
        have hji : idx j = i := by simp [idx, j]
        refine ⟨⟨j, ?_⟩, ?_⟩
        · simpa [m', hji] using a
        · simp [f, hji]
    let q := Equiv.ofBijective f hf
    let k : (⨁ (fun p => V p)) ≅ ⨁ (fun p => F.obj (W p)) :=
      (biproduct.whiskerEquiv q (fun p => eqToIso (by rfl))).symm
    refine ⟨m', ⟨F.preimageIso (d ≪≫ k ≪≫ (F.mapBiproduct W).symm)⟩⟩
  letI : Ground.IsFusionCategory E := {
    hom_finite := by
      intro A B
      letI : FiniteDimensional ℂ (A.obj ⟶ B.obj) := Ground.IsFusionCategory.hom_finite _ _
      exact Module.Finite.of_surjective
        (InducedCategory.homLinearEquiv (R := ℂ) (X := A) (Y := B)).symm.toLinearMap
        (InducedCategory.homLinearEquiv (R := ℂ) (X := A) (Y := B)).symm.surjective
    unit_simple := by
      have : Simple (F.obj (𝟙_ E)) := Ground.IsFusionCategory.unit_simple
      exact Functor.simple_of_simple_obj F _
    finite_semisimple := ⟨_, S, hs, hsinj, hfin⟩ }
  exact { Obj := E }
/-- The full faithful braided inclusion of the generated fusion category. -/
def generatedFusionInclusion (D : Ground.BraidedFusionCategory.{v,u}) (X : D.Obj) :
    (generatedFusion D X).Obj ⥤ D.Obj := generatedInclusion X

instance (D : Ground.BraidedFusionCategory.{v,u}) (X : D.Obj) :
    (generatedFusionInclusion D X).Full := by
  change (generatedInclusion X).Full
  infer_instance
instance (D : Ground.BraidedFusionCategory.{v,u}) (X : D.Obj) :
    (generatedFusionInclusion D X).Faithful := by
  change (generatedInclusion X).Faithful
  infer_instance
instance (D : Ground.BraidedFusionCategory.{v,u}) (X : D.Obj) :
    (generatedFusionInclusion D X).Monoidal := by
  change (generatedInclusion X).Monoidal
  infer_instance
instance (D : Ground.BraidedFusionCategory.{v,u}) (X : D.Obj) :
    (generatedFusionInclusion D X).Braided := by
  change (generatedInclusion X).Braided
  infer_instance

/-- The inclusion has precisely the generated objects as its essential image. -/
theorem generatedFusionInclusion_essentialImage (D : Ground.BraidedFusionCategory.{v,u})
    (X Y : D.Obj) : GeneratedBy X Y ↔
      ∃ Z : (generatedFusion D X).Obj, Nonempty ((generatedFusionInclusion D X).obj Z ≅ Y) :=
  generatedInclusion_essentialImage X Y

/-- Corresponding objects have isomorphic braid images along the inclusion. -/
def generatedFusionInclusionBraidImageIso (D : Ground.BraidedFusionCategory.{v,u})
    (X : D.Obj) (Y : (generatedFusion D X).Obj) (n : ℕ) :
    braidImage Y n ≃* braidImage ((generatedFusionInclusion D X).obj Y) n :=
  generatedInclusionBraidImageIso X Y n
end PropertyF.Ground.Cabling
