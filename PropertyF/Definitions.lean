module
public import Mathlib.CategoryTheory.Monoidal.Braided.Basic
public import Mathlib.CategoryTheory.Monoidal.Rigid.Basic
public import Mathlib.CategoryTheory.Monoidal.Linear
public import Mathlib.CategoryTheory.Abelian.Basic
public import Mathlib.CategoryTheory.Simple
public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.LinearAlgebra.FiniteDimensional.Defs
public import Mathlib.Analysis.Complex.Basic

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.MonoidalCategory
namespace PropertyF

universe v u
variable {C : Type u} [Category.{v} C] [MonoidalCategory C]

/-- Right-associated tensor powers. -/
def tensorPower (X : C) : ℕ → C
  | 0 => 𝟙_ C
  | n + 1 => X ⊗ tensorPower X n

/-- Adjacent self-braidings, with the associators that the paper suppresses.
The index `n` means `n+2` strands. -/
def braidGenerator [BraidedCategory C] (X : C) : ∀ n,
    Fin (n + 1) → Aut (tensorPower X (n + 2))
  | n, ⟨0, _⟩ =>
    Aut.of ((α_ X X (tensorPower X n)).symm ≪≫
      ((β_ X X) ⊗ᵢ Iso.refl (tensorPower X n)) ≪≫ α_ X X (tensorPower X n))
  | n + 1, ⟨i + 1, hi⟩ =>
    Aut.of (Iso.refl X ⊗ᵢ (braidGenerator X n ⟨i, Nat.lt_of_succ_lt_succ hi⟩).asIso)
  | 0, ⟨i + 1, hi⟩ => (Nat.not_lt_zero i (Nat.lt_of_succ_lt_succ hi)).elim

/-- The subgroup generated by the adjacent braidings. This is precisely the
braid group image, without requiring a separately implemented Artin group.
Here `n` denotes `n+2` strands. -/
def braidImage [BraidedCategory C] (X : C) (n : ℕ) :
    Subgroup (Aut (tensorPower X (n + 2))) :=
  Subgroup.closure (Set.range (braidGenerator X n))

/-- Finiteness of all braid images of a single object. -/
def ObjectPropertyF [BraidedCategory C] (X : C) : Prop :=
  ∀ n, Finite (braidImage X n)

/-- Property F as defined in §1, using genuine categorical automorphisms. -/
def HasPropertyF (C : Type u) [Category.{v} C] [MonoidalCategory C]
    [BraidedCategory C] : Prop := ∀ X : C, ObjectPropertyF X

/-- Weak integrality, with the dimension supplied by fusion data. -/
def WeaklyIntegral (globalFPDimension : ℝ) : Prop :=
  ∃ z : ℤ, globalFPDimension = z

/-- Pseudo-unitarity is equality of global dimensions. -/
def PseudoUnitary (globalDimension : ℂ) (globalFPDimension : ℝ) : Prop :=
  globalDimension = (globalFPDimension : ℂ)

end PropertyF
