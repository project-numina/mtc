module
public import MTC.Center.Braid.ImageCore

open MTC.Fusion MTC.Braided MTC.Center.Braid MTC.PropertyF.Reduction

/-! # An actual generator of the canonical product-image fusion subcategory -/

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.MonoidalCategory CategoryTheory.Limits
namespace MTC.Center.Normalization
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
universe v u
variable (C : BraidedFusionCategory.{v,u})
  [RigidCategory (Center C.Obj)] [IsFusionCategory (Center C.Obj)]
local notation "Z" => bundledCenter C
attribute [local instance] Abelian.hasFiniteBiproducts

/-- The direct sum of all simple product-retract representatives. -/
def productGenerator : Center C.Obj := by
  classical
  exact ⨁ (fun i : productLabels C => simples Z i.1)

/-- The actual product generator is itself a product retract. -/
theorem productGenerator_productRetract : MTC.Center.ProductRetract (productGenerator C) := by
  classical
  change MTC.Center.ProductRetract (⨁ (fun i : productLabels C => simples Z i.1))
  apply MTC.Center.productRetract_finiteBiproduct
  intro i
  exact (mem_productLabels C i.1).mp i.property

/-- The actual product-retract objects are exactly the objects generated by
the direct sum of their simple representatives. -/
theorem generatedBy_productGenerator_iff_productRetract (W : Center C.Obj) :
    GeneratedBy (productGenerator C) W ↔ MTC.Center.ProductRetract W := by
  classical
  constructor
  · exact MTC.Center.productRetract_generatedBy (productGenerator_productRetract C)
  · intro hW
    obtain ⟨m, ⟨e⟩⟩ := simples_decompose Z W
    let V : (Σ i, Fin (m i)) → Center C.Obj := fun a => simples Z a.1
    apply generatedBy_of_iso (Y := ⨁ V) _ e
    apply generatedBy_finiteBiproduct
    intro a
    let r : Retract (simples Z a.1) W :=
      (Retract.mk (biproduct.ι V a) (biproduct.π V a) (biproduct.ι_π_self V a)).trans
        (Retract.ofIso e.symm)
    have ha : a.1 ∈ productLabels C :=
      (mem_productLabels C a.1).mpr (MTC.Center.productRetract_of_retract r hW)
    let i : productLabels C := ⟨a.1, ha⟩
    let T : productLabels C → Center C.Obj := fun i => simples Z i.1
    let r' : Retract (simples Z a.1) (productGenerator C) :=
      ⟨biproduct.ι T i, biproduct.π T i, biproduct.ι_π_self T i⟩
    exact generatedBy_retract (generatedBy_self (productGenerator C)) r'

omit [RigidCategory (Center C.Obj)] [IsFusionCategory (Center C.Obj)] in
/-- Every retract-closed tensor class containing both canonical images
contains every product retract. This is the minimality property of their join. -/
theorem productRetract_minimal
    (P : Center C.Obj → Prop)
    (hpositive : ∀ X : C.Obj, P ((Center.ofBraided C.Obj).obj X))
    (hnegative : ∀ X : C.Obj, P ((MTC.Center.negative C.Obj).obj X))
    (htensor : ∀ {X Y : Center C.Obj}, P X → P Y → P (X ⊗ Y))
    (hretract : ∀ {X Y : Center C.Obj}, Retract X Y → P Y → P X)
    (W : Center C.Obj) (hW : MTC.Center.ProductRetract W) : P W := by
  obtain ⟨X, Y, ⟨r⟩⟩ := hW
  exact hretract r (htensor (hpositive X) (hnegative Y))

end MTC.Center.Normalization
end
