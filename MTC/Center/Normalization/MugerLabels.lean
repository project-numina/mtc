module
public import MTC.Center.Normalization.AdjointDegrees
public import MTC.Center.Basic
public import MTC.Center.Braid.CentralityClosure
public import MTC.Center.Normalization.ScalarFusionCharacter

open MTC.Fusion MTC.Braided MTC.Center.Braid

/-! # Müger-centre fusion labels -/

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.MonoidalCategory CategoryTheory.BraidedCategory CategoryTheory.Limits
namespace MTC.Center.Normalization
universe v u
variable {D : Type u} [Category.{v} D] [MonoidalCategory D] [BraidedCategory D]

/-- Transparent objects remain transparent under tensor product. -/
theorem transparent_tensor {X Y : D} (hX : MTC.Center.Transparent X)
    (hY : MTC.Center.Transparent Y) : MTC.Center.Transparent (X ⊗ Y) := by
  intro T
  have hx : (β_ X T).hom = (β_ T X).inv := by
    apply (cancel_mono (β_ T X).hom).1
    simpa using hX T
  have hy : (β_ Y T).hom = (β_ T Y).inv := by
    apply (cancel_mono (β_ T Y).hom).1
    simpa using hY T
  simp [braiding_tensor_left_hom, braiding_tensor_right_hom, hx, hy, Category.assoc]

/-- The tensor unit is transparent. -/
theorem transparent_unit : MTC.Center.Transparent (𝟙_ D) := by
  intro T
  simp

/-- Transparency passes to retracts. -/
theorem transparent_of_retract {X Y : D} (r : Retract X Y)
    (hY : MTC.Center.Transparent Y) : MTC.Center.Transparent X :=
  fun T ↦ MTC.Center.Braid.doubleBraiding_eq_one_of_retract r (hY T)

variable [Abelian D] [MonoidalPreadditive D]
attribute [local instance] Abelian.hasFiniteBiproducts

/-- A finite sum of transparent objects is transparent. -/
theorem transparent_biproduct {ι : Type} [Fintype ι] (V : ι → D)
    (hV : ∀ i, MTC.Center.Transparent (V i)) : MTC.Center.Transparent (⨁ V) :=
  fun T ↦ MTC.Center.Braid.doubleBraiding_eq_one_biproduct (fun i ↦ hV i T)

omit [Abelian D] [MonoidalPreadditive D] in
/-- Every tensor power of a transparent object is transparent. -/
theorem transparent_tensorPower {X : D} (hX : MTC.Center.Transparent X) (n : ℕ) :
    MTC.Center.Transparent (tensorPower X n) := by
  induction n with
  | zero => exact transparent_unit
  | succ n ih => exact transparent_tensor hX ih

/-- Transparency passes to objects generated by tensor powers, finite sums and
retracts. -/
theorem transparent_generatedBy {X Y : D} (hX : MTC.Center.Transparent X)
    (hY : GeneratedBy X Y) : MTC.Center.Transparent Y := by
  obtain ⟨n, k, ⟨r⟩⟩ := hY
  exact transparent_of_retract r (transparent_biproduct _ (fun i ↦ transparent_tensorPower hX (k i)))

end MTC.Center.Normalization
end

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.MonoidalCategory CategoryTheory.BraidedCategory
namespace MTC.Center.Normalization
universe v u
variable (C : BraidedFusionCategory.{v,u})

/-- The actual simple labels in the Müger centre. -/
def mugerLabels : Finset (Fin (rank C)) := by
  classical
  exact Finset.univ.filter (fun i ↦ MTC.Center.Transparent (simples C i))

/-- Membership in the label set is actual transparency. -/
theorem mem_mugerLabels (i : Fin (rank C)) :
    i ∈ mugerLabels C ↔ MTC.Center.Transparent (simples C i) := by
  classical
  simp [mugerLabels]

/-- The actual Müger-centre simple labels form a fusion subring. -/
theorem mugerLabels_fusionSubring : IsFusionSubring C (mugerLabels C) := by
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · intro i hi
    apply (mem_mugerLabels C _).mpr
    let X := simples C i
    let e : (ᘁX) ≅ (Xᘁ) := leftDualIso HasLeftDual.exact
      (BraidedCategory.exactPairing_swap X (Xᘁ))
    let ⟨e'⟩ := dualIndex_iso (D := C) i
    apply transparent_of_retract (Retract.ofIso (e'.symm ≪≫ e))
    exact transparent_generatedBy ((mem_mugerLabels C i).mp hi) (generatedBy_rightDual X)
  · intro i hi j hj k hk
    apply (mem_mugerLabels C _).mpr
    obtain ⟨r⟩ := fusionCoeff_retract hk
    exact transparent_of_retract r
      (transparent_tensor ((mem_mugerLabels C i).mp hi) ((mem_mugerLabels C j).mp hj))
  · apply (mem_mugerLabels C _).mpr
    obtain ⟨e⟩ := unitIndex_iso C
    exact transparent_of_retract (Retract.ofIso e) transparent_unit

/-- Positive pivotal dimensions on ambient-neutral transparent labels and FP
norm saturation on all transparent labels give actual pivotal normalization
on the Müger centre. -/
theorem normalize_pivotal_on_muger_of_norm_saturation
    (p : MTC.CategoryTheory.Dimensions.PivotalStructure (C := C.Obj))
    (hsat : ∀ i, MTC.Center.Transparent (simples C i) →
      ‖MTC.CategoryTheory.Dimensions.pivotalDimension C p (simples C i)‖ = fpSimple C i)
    (hpositive : ∀ i, MTC.Center.Transparent (simples C i) → fusionDegree C i = 0 →
      ∃ r : ℝ, 0 < r ∧ MTC.CategoryTheory.Dimensions.pivotalDimension C p (simples C i) = r) :
    ∃ q : MTC.CategoryTheory.Dimensions.PivotalStructure (C := C.Obj), ∀ i,
      MTC.Center.Transparent (simples C i) →
      MTC.CategoryTheory.Dimensions.pivotalDimension C q (simples C i) = (fpSimple C i : ℂ) := by
  obtain ⟨q, hq⟩ := normalize_pivotal_of_subring_norm_saturation (mugerLabels_fusionSubring C) p
    (fun i ↦ hsat i ((mem_mugerLabels C i).mp i.property))
    (fun i ↦ hpositive i ((mem_mugerLabels C i).mp i.property))
  exact ⟨q, fun i hi ↦ hq ⟨i, (mem_mugerLabels C i).mpr hi⟩⟩

end MTC.Center.Normalization
end
