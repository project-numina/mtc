module
public import MTC.Center.Normalization.ProductGenerator
public import MTC.PropertyF.Pivotal.GeneratedCategory

open MTC.Fusion MTC.Braided MTC.PropertyF.Reduction MTC.PropertyF.Pivotal

/-! # The actual product-image fusion category -/

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.MonoidalCategory
namespace MTC.Center.Normalization
set_option backward.isDefEq.respectTransparency false
set_option backward.defeqAttrib.useBackward true
set_option maxHeartbeats 800000
universe v u
variable (C : BraidedFusionCategory.{v,u})
  [RigidCategory (Center C.Obj)] [IsFusionCategory (Center C.Obj)]
local notation "Z" => bundledCenter C

/-- The actual fusion category generated by the canonical product images. -/
def bundledProductCategory : BraidedFusionCategory.{v,max u v} :=
  bundledGenerated Z (productGenerator C)

/-- Objects of the product-image category are precisely product retracts in
the actual Drinfeld centre. -/
theorem productCategory_object_is_productRetract (Y : (bundledProductCategory C).Obj) :
    MTC.Center.ProductRetract Y.obj :=
  (generatedBy_productGenerator_iff_productRetract C Y.obj).mp Y.property

/-- The essential image of the actual generated fusion category is exactly
the product-retract class. -/
theorem productCategory_essentialImage_iff (W : Center C.Obj) :
    (∃ Y : (bundledProductCategory C).Obj, Nonempty (Y.obj ≅ W)) ↔
      MTC.Center.ProductRetract W := by
  constructor
  · rintro ⟨Y, ⟨e⟩⟩
    exact MTC.Center.productRetract_of_retract (Retract.ofIso e.symm)
      (productCategory_object_is_productRetract C Y)
  · intro hW
    exact ⟨⟨W, (generatedBy_productGenerator_iff_productRetract C W).mpr hW⟩,
      ⟨Iso.refl W⟩⟩

/-- Property F on the ambient braided fusion category transfers to its
actual product-image fusion subcategory in the Drinfeld centre. -/
theorem productCategory_propertyF (hF : HasPropertyF C.Obj) :
    HasPropertyF (bundledProductCategory C).Obj := by
  change HasPropertyF (GeneratedCategory Z (productGenerator C))
  let F := (generatedProperty Z (productGenerator C)).ι
  let : F.Faithful := inferInstance
  let : F.Monoidal := inferInstance
  let : F.Braided := inferInstance
  intro Y n
  have hY : ObjectPropertyF (F.obj Y) :=
    MTC.Center.productRetract_propertyF (productCategory_object_is_productRetract C Y) hF
  let : Finite (braidImage (F.obj Y) n) := hY n
  exact Finite.of_injective (MTC.Modular.braidImageFunctorIso F Y n)
    (MTC.Modular.braidImageFunctorIso F Y n).injective

end MTC.Center.Normalization
end
