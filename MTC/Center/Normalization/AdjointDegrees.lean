module
public import MTC.Center.Normalization.UniversalGrading
public import MTC.Center.Braid.PivotalRegularSupport

open MTC.Fusion MTC.Braided MTC.Center.Braid

/-! # Adjoint fusion labels have neutral universal degree

The adjoint fusion labels are the intersection of all fusion subrings
containing the constituents of each `X ⊗ X*`. This file proves the inclusion
into the neutral universal degree. `AdjointQuotient` proves the reverse
inclusion for these fusion labels.
-/

@[expose] public noncomputable section
namespace MTC.Center.Normalization
universe v u
variable (C : BraidedFusionCategory.{v,u})

/-- Labels of simple constituents of `X ⊗ X*` for a simple X. -/
def AdjointSeed (k : Fin (rank C)) : Prop :=
  ∃ i, 0 < fusionCoeff C i (dualIndex C i) k

/-- Fusion labels generated by the constituents of `X ⊗ X*`. -/
def IsAdjointLabel (k : Fin (rank C)) : Prop :=
  ∀ A : Finset (Fin (rank C)), IsFusionSubring C A →
    (∀ j, AdjointSeed C j → j ∈ A) → k ∈ A

/-- All labels of degree zero. -/
def neutralDegreeLabels : Finset (Fin (rank C)) := by
  classical
  exact Finset.univ.filter (fun i ↦ fusionDegree C i = 0)

/-- The labels of degree zero form a fusion subring. -/
theorem neutralDegreeLabels_fusionSubring : IsFusionSubring C (neutralDegreeLabels C) := by
  classical
  have hmem (i : Fin (rank C)) : i ∈ neutralDegreeLabels C ↔ fusionDegree C i = 0 := by
    simp [neutralDegreeLabels]
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · intro i hi
    rw [hmem, fusionDegree_dual, (hmem i).mp hi, neg_zero]
  · intro i hi j hj k hk
    rw [hmem, fusionDegree_tensor C hk, (hmem i).mp hi, (hmem j).mp hj, add_zero]
  · rw [hmem, fusionDegree_unit]

/-- Every constituent of `X ⊗ X*` has neutral degree. -/
theorem adjointSeed_neutral {k : Fin (rank C)} (h : AdjointSeed C k) :
    fusionDegree C k = 0 := by
  obtain ⟨i, hi⟩ := h
  rw [fusionDegree_tensor C hi, fusionDegree_dual, add_neg_cancel]

/-- Every adjoint fusion label has neutral degree. -/
theorem adjointLabel_neutral {k : Fin (rank C)} (h : IsAdjointLabel C k) :
    fusionDegree C k = 0 := by
  classical
  have hmem := h (neutralDegreeLabels C) (neutralDegreeLabels_fusionSubring C) (fun _ hj ↦ by
    simp [neutralDegreeLabels, adjointSeed_neutral C hj])
  simpa [neutralDegreeLabels] using hmem

end MTC.Center.Normalization
end
