module
public import Mathlib.Tactic

/-!
# Normal forms for type-A generators

The strand-moving words give coset representatives for a group generated by
type-A involutions. This yields a factorial bound for the group's order.
-/
@[expose] public noncomputable section
namespace MTC.CentreCalculus

variable {G : Type*} [Monoid G]

/-- A family of involutions satisfying the type-A braid and commutation relations. -/
structure IsTypeAFamily (s : ℕ → G) (m : ℕ) : Prop where
  square : ∀ i, i < m → s i * s i = 1
  braid : ∀ i, i + 1 < m → s i * s (i + 1) * s i = s (i + 1) * s i * s (i + 1)
  commute : ∀ i j, i + 1 < j → j < m → s i * s j = s j * s i

variable {s : ℕ → G} {m : ℕ}

/-- The word moving strand zero through the first `j` adjacent positions. -/
def moveWord (s : ℕ → G) : ℕ → G
  | 0 => 1
  | j + 1 => s j * moveWord s j

variable (hb : ∀ i, i + 1 < m → s i * s (i + 1) * s i = s (i + 1) * s i * s (i + 1))
  (hc : ∀ i j, i + 1 < j → j < m → s i * s j = s j * s i)

include hc in
/-- A generator beyond a word's support commutes with the word. -/
theorem commute_moveWord (i j : ℕ) (hji : j + 1 ≤ i) (him : i < m) :
    s i * moveWord s j = moveWord s j * s i := by
  induction j with
  | zero => simp [moveWord]
  | succ j ih =>
    rw [moveWord, ← mul_assoc, (hc j i (by omega) him).symm, mul_assoc,
      ih (by omega), ← mul_assoc]

include hb hc in
/-- Moving a crossing past the strand-moving word shifts its index by one.
This is the main rewriting step for the type-A coset normal form. -/
theorem moveWord_exchange (j i : ℕ) (hij : i + 1 < j) (hjm : j ≤ m) :
    s i * moveWord s j = moveWord s j * s (i + 1) := by
  induction j generalizing i with
  | zero => omega
  | succ j ih =>
    by_cases h : i + 1 = j
    · subst j
      simp only [moveWord, ← mul_assoc, hb i (by omega)]
      simp only [mul_assoc, commute_moveWord hc (i + 1) i (by omega) (by omega)]
    · simp only [moveWord, ← mul_assoc]
      rw [hc i j (by omega) (by omega), mul_assoc, ih i (by omega) (by omega), ← mul_assoc]

end MTC.CentreCalculus

namespace MTC.CentreCalculus
variable {G : Type*} [Group G] {s : ℕ → G} {m : ℕ}

/-- Shifting a type-A family into a subgroup preserves its relations. -/
theorem IsTypeAFamily.shift {H : Subgroup G} {t : ℕ → H}
    (hrel : IsTypeAFamily s (m + 1))
    (ht : ∀ i, i < m → (t i : G) = s (i + 1)) : IsTypeAFamily t m :=
  ⟨fun i hi ↦ Subtype.ext <| by
    simpa only [Subgroup.coe_mul, Subgroup.coe_one, ht i hi] using hrel.square (i + 1) (by omega),
   fun i hi ↦ Subtype.ext <| by
    simpa only [Subgroup.coe_mul, ht i (by omega), ht (i + 1) (by omega), Nat.add_assoc] using
      hrel.braid (i + 1) (by omega),
   fun i j hij hj ↦ Subtype.ext <| by
    simpa only [Subgroup.coe_mul, ht i (by omega), ht j hj] using
      hrel.commute (i + 1) (j + 1) (by omega) (by omega)⟩

variable (hrel : IsTypeAFamily s m)

/-- An element has a strand-moving representative modulo the shifted subgroup. -/
abbrev HasMoveWordCoset (s : ℕ → G) (m : ℕ) (g : G) : Prop :=
  ∃ j ≤ m, ∃ h ∈ Subgroup.closure (Set.range (fun t : Fin (m - 1) ↦ s (t.val + 1))),
    g = moveWord s j * h

include hrel in
/-- One generator sends each standard coset representative to another,
up to a generator from the shifted parabolic subgroup. -/
theorem moveWord_coset_step {i j : ℕ} (hi : i < m) (hj : j ≤ m) :
    HasMoveWordCoset s m (s i * moveWord s j) := by
  let H := Subgroup.closure (Set.range (fun t : Fin (m - 1) => s (t.val + 1)))
  have memH (a : ℕ) (ha : 0 < a) (ham : a < m) : s a ∈ H :=
    Subgroup.subset_closure ⟨⟨a - 1, by omega⟩, congrArg s (Nat.sub_add_cancel (by omega))⟩
  by_cases h₁ : i + 1 < j
  · exact ⟨j, hj, s (i + 1), memH _ (by omega) (by omega),
      moveWord_exchange hrel.braid hrel.commute j i h₁ hj⟩
  · by_cases h₂ : j = i + 1
    · subst j
      refine ⟨i, by omega, 1, H.one_mem, ?_⟩
      simp only [moveWord, mul_one, ← mul_assoc, hrel.square i hi, one_mul]
    · by_cases h₃ : j = i
      · subst j
        exact ⟨i + 1, by omega, 1, H.one_mem, (mul_one _).symm⟩
      · exact ⟨j, hj, s i, memH _ (by omega) hi,
          commute_moveWord hrel.commute i j (by omega) hi⟩

include hrel in
/-- A generator preserves the strand-moving coset normal form. -/
theorem HasMoveWordCoset.mul_generator {i : ℕ} {g : G} (hi : i < m)
    (hg : HasMoveWordCoset s m g) : HasMoveWordCoset s m (s i * g) :=
  let ⟨j, hj, h, hh, hg⟩ := hg
  let ⟨k, hk, h', hh', heq⟩ := moveWord_coset_step hrel hi hj
  ⟨k, hk, h' * h, Subgroup.mul_mem _ hh' hh, by rw [hg, ← mul_assoc, heq, mul_assoc]⟩

include hrel in
/-- Every word in type-A generators has a strand-moving coset normal form. -/
theorem exists_moveWord_coset {g : G}
    (hg : g ∈ Subgroup.closure (Set.range (fun t : Fin m ↦ s t.val))) : HasMoveWordCoset s m g :=
  Subgroup.closure_induction_left
    ⟨0, Nat.zero_le _, 1, Subgroup.one_mem _, by simp [moveWord]⟩
    (fun _ ⟨i, hi⟩ _ _ ih ↦ hi ▸ HasMoveWordCoset.mul_generator hrel i.isLt ih)
    (fun _ ⟨i, hi⟩ _ _ ih ↦ hi ▸ by
      simpa only [inv_eq_of_mul_eq_one_left (hrel.square i.val i.isLt)] using
        HasMoveWordCoset.mul_generator hrel i.isLt ih) hg

end MTC.CentreCalculus

namespace MTC.CentreCalculus
variable {G : Type*} [Group G]

/-- A finite family of coset representatives bounds the order of a group. -/
theorem finite_card_le_of_coset_cover {ι : Type*} [Finite ι] (H : Subgroup G) [Finite H]
    (r : ι → G) (hcover : ∀ g, ∃ i, ∃ h : H, g = r i * h) :
    Finite G ∧ Nat.card G ≤ Nat.card ι * Nat.card H :=
  let f : ι × H → G := fun x ↦ r x.1 * x.2
  let hf : Function.Surjective f := fun g ↦
    let ⟨i, h, hh⟩ := hcover g
    ⟨(i, h), hh.symm⟩
  let : Finite G := Finite.of_surjective f hf
  ⟨inferInstance, by simpa only [Nat.card_prod] using Nat.card_le_card_of_surjective f hf⟩

/-- A group generated by `m` type-A involutions is finite of order at most
`(m+1)!`. The proof uses the explicit parabolic coset normal form. -/
theorem finite_card_of_typeA (m : ℕ) : ∀ {G : Type*} [Group G] (s : ℕ → G),
    IsTypeAFamily s m →
    Subgroup.closure (Set.range (fun t : Fin m => s t.val)) = ⊤ →
    Finite G ∧ Nat.card G ≤ Nat.factorial (m + 1) := by
  induction m with
  | zero =>
    intro G inst s _ hgen
    have htop : (⊥ : Subgroup G) = ⊤ := by simpa using hgen
    let : Subsingleton G := Subgroup.subsingleton_iff.mp (subsingleton_iff_bot_eq_top.mp htop)
    exact ⟨Finite.of_subsingleton, by simp [Nat.card_unique]⟩
  | succ m ih =>
    intro G inst s hrel hgen
    let H := Subgroup.closure (Set.range (fun t : Fin m => s (t.val + 1)))
    let t : ℕ → H := fun i => if h : i < m then
      ⟨s (i + 1), Subgroup.subset_closure ⟨⟨i, h⟩, rfl⟩⟩ else 1
    have ht (i : ℕ) (hi : i < m) : (t i : G) = s (i + 1) := by simp [t, hi]
    have htgen : Subgroup.closure (Set.range (fun q : Fin m => t q.val)) = ⊤ := by
      apply Subgroup.map_injective H.subtype_injective
      simp only [MonoidHom.map_closure, Subgroup.map_top, Subgroup.range_subtype,
        ← Set.range_comp, Function.comp_def, Subgroup.subtype_apply, ht _ (Fin.isLt _), H]
    obtain ⟨hfin, hcard⟩ := ih t (hrel.shift ht) htgen
    let : Finite H := hfin
    have hcover (g : G) : ∃ j : Fin (m + 2), ∃ h : H, g = moveWord s j.val * h :=
      let ⟨j, hj, h, hh, he⟩ := exists_moveWord_coset hrel (hgen.symm ▸ Subgroup.mem_top g)
      ⟨⟨j, by omega⟩, ⟨h, hh⟩, he⟩
    obtain ⟨hG, hbound⟩ := finite_card_le_of_coset_cover H (fun j : Fin (m + 2) ↦ moveWord s j.val) hcover
    exact ⟨hG, by simpa only [Nat.card_fin, Nat.factorial_succ] using
      hbound.trans (Nat.mul_le_mul_left (Nat.card (Fin (m + 2))) hcard)⟩

end MTC.CentreCalculus
