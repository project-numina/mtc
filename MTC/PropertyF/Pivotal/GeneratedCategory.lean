module
public import MTC.Center.Normalization.MugerCategory
public import MTC.Fusion.UnitPower
public import MTC.PropertyF.Pivotal.Statement

/-! # The actual tensor subcategory generated by an object

The objects are exactly the categorical retracts of finite sums of tensor
powers. This constructs their monoidal, rigid and abelian full subcategory;
finite braid images are a separate question.
-/

@[expose] public noncomputable section
open CategoryTheory CategoryTheory.MonoidalCategory CategoryTheory.Limits
open MTC.Fusion MTC.Braided MTC.Center.Normalization
open scoped ZeroObject
namespace MTC.PropertyF.Pivotal
universe v u
variable (C : BraidedFusionCategory.{v,u}) (X : C.Obj)
attribute [local instance] Abelian.hasFiniteBiproducts

/-- The actual objects in the tensor closure of X. -/
def generatedProperty : ObjectProperty C.Obj := GeneratedBy X

/-- The actual full subcategory generated by X. -/
abbrev GeneratedCategory := (generatedProperty C X).FullSubcategory

instance generatedProperty_monoidal : (generatedProperty C X).IsMonoidal where
  prop_unit := MTC.Braided.generatedBy_unit X
  prop_tensor _ _ hY hZ := MTC.Braided.generatedBy_tensor hY hZ

/-- The tensor closure is closed under right duality. -/
theorem generated_rightDual {Y : C.Obj} (hY : GeneratedBy X Y) : GeneratedBy X (Yᘁ) :=
  MTC.Braided.generatedBy_trans hY (generatedBy_rightDual Y)

instance generatedCategory_rightRigid : RightRigidCategory (GeneratedCategory C X) where
  rightDual Y :=
    { rightDual := ⟨Y.objᘁ, generated_rightDual C X Y.property⟩
      exact :=
        { coevaluation' := ObjectProperty.homMk (η_ Y.obj (Y.objᘁ))
          evaluation' := ObjectProperty.homMk (ε_ Y.obj (Y.objᘁ))
          coevaluation_evaluation' := by
            apply ObjectProperty.hom_ext
            exact ExactPairing.coevaluation_evaluation Y.obj (Y.objᘁ)
          evaluation_coevaluation' := by
            apply ObjectProperty.hom_ext
            exact ExactPairing.evaluation_coevaluation Y.obj (Y.objᘁ) } }

instance generatedCategory_leftRigid : LeftRigidCategory (GeneratedCategory C X) where
  leftDual Y :=
    { leftDual := Yᘁ
      exact := CategoryTheory.BraidedCategory.exactPairing_swap Y (Yᘁ) }

instance generatedCategory_rigid : RigidCategory (GeneratedCategory C X) where

instance generatedProperty_subobjects : (generatedProperty C X).IsClosedUnderSubobjects where
  prop_of_mono f _ hY := by
    let : IsSplitMono f := mono_splits f
    exact MTC.Braided.generatedBy_retract hY ⟨f, retraction f, IsSplitMono.id f⟩

instance generatedProperty_quotients : (generatedProperty C X).IsClosedUnderQuotients where
  prop_of_epi f _ hY := by
    let : IsSplitEpi f := epi_splits_in_fusion C f
    exact MTC.Braided.generatedBy_retract hY ⟨section_ f, f, IsSplitEpi.id f⟩

instance generatedProperty_containsZero : (generatedProperty C X).ContainsZero where
  exists_zero := by
    let r : Retract ((0 : C.Obj)) (𝟙_ C.Obj) := ⟨0, 0, by simp⟩
    exact ⟨(0 : C.Obj), isZero_zero _,
      MTC.Braided.generatedBy_retract (MTC.Braided.generatedBy_unit X) r⟩

instance generatedProperty_finiteProducts : (generatedProperty C X).IsClosedUnderFiniteProducts := by
  apply ObjectProperty.IsClosedUnderFiniteProducts.of_isClosedUnderLimitsOfShape
  intro J hJ
  let : Finite J := hJ
  apply ObjectProperty.IsClosedUnderLimitsOfShape.mk'
  rintro _ ⟨F, hF⟩
  let : Fintype J := Fintype.ofFinite J
  let V : J → C.Obj := fun j ↦ F.obj ⟨j⟩
  have hV : GeneratedBy X (⨁ V) :=
    MTC.Braided.generatedBy_finiteBiproduct V (fun j ↦ hF ⟨j⟩)
  let e : limit F ≅ ⨁ V :=
    (HasLimit.isoOfNatIso (Discrete.natIsoFunctor (F := F))) ≪≫ (biproduct.isoProduct V).symm
  exact MTC.Braided.generatedBy_of_iso hV e

/-- The actual full generated subcategory is abelian. -/
instance generatedCategory_abelian : Abelian (GeneratedCategory C X) := inferInstance

/-- Every ambient simple summand of a generated object is generated. -/
theorem generated_piece (Y : GeneratedCategory C X)
    (a : MTC.CategoryTheory.Dimensions.simplePieces C Y.obj) :
    GeneratedBy X (simples C a.1) := by
  let V := MTC.CategoryTheory.Dimensions.simplePiecesObject C Y.obj
  let e := MTC.CategoryTheory.Dimensions.simpleDecomposition C Y.obj
  let r : Retract (simples C a.1) Y.obj :=
    ((biproduct.bicone V).retract a).trans (Retract.ofIso e.symm)
  exact generatedBy_retract Y.property r

def generatedPieces (Y : GeneratedCategory C X)
    (a : MTC.CategoryTheory.Dimensions.simplePieces C Y.obj) : GeneratedCategory C X :=
  ⟨simples C a.1, generated_piece C X Y a⟩

instance generatedInclusion_preservesMonos : (generatedProperty C X).ι.PreservesMonomorphisms :=
  (generatedProperty C X).preservesMonomorphisms_ι_of_isNormalEpiCategory

theorem generatedPieces_simple (Y : GeneratedCategory C X)
    (a : MTC.CategoryTheory.Dimensions.simplePieces C Y.obj) : Simple (generatedPieces C X Y a) := by
  let : Simple ((generatedProperty C X).ι.obj (generatedPieces C X Y a)) := by
    change Simple (simples C a.1)
    exact simples_simple C a.1
  exact Functor.simple_of_simple_obj (generatedProperty C X).ι (generatedPieces C X Y a)

def generatedPiecesDecomposition (Y : GeneratedCategory C X) : Y ≅ ⨁ (generatedPieces C X Y) := by
  let F := (generatedProperty C X).ι
  let e := MTC.CategoryTheory.Dimensions.simpleDecomposition C Y.obj
  let b : F.obj (⨁ (generatedPieces C X Y)) ≅ ⨁ (F.obj ∘ generatedPieces C X Y) :=
    F.mapBiproduct (generatedPieces C X Y)
  exact F.preimageIso (e ≪≫ b.symm)

/-- Labels of actual simple objects in the generated subcategory. -/
def generatedLabels : Finset (Fin (rank C)) := by
  classical
  exact Finset.univ.filter (fun i ↦ GeneratedBy X (simples C i))

theorem mem_generatedLabels (i : Fin (rank C)) :
    i ∈ generatedLabels C X ↔ GeneratedBy X (simples C i) := by
  classical
  simp [generatedLabels]

abbrev GeneratedSimpleIndex := {i : Fin (rank C) // i ∈ generatedLabels C X}

def generatedSimple (i : GeneratedSimpleIndex C X) : GeneratedCategory C X :=
  ⟨simples C i, (mem_generatedLabels C X i).mp i.property⟩

theorem generatedSimple_simple (i : GeneratedSimpleIndex C X) : Simple (generatedSimple C X i) := by
  let : Simple ((generatedProperty C X).ι.obj (generatedSimple C X i)) := by
    change Simple (simples C i)
    exact simples_simple C i
  exact Functor.simple_of_simple_obj (generatedProperty C X).ι (generatedSimple C X i)

theorem generatedSimple_injective {i j : GeneratedSimpleIndex C X}
    (h : Nonempty (generatedSimple C X i ≅ generatedSimple C X j)) : i = j := by
  apply Subtype.ext
  apply simples_injective C
  obtain ⟨e⟩ := h
  have he := (generatedProperty C X).ι.mapIso e
  change simples C i ≅ simples C j at he
  exact ⟨he⟩

/-- Every generated object is a finite sum of distinct chosen ambient simple
representatives that themselves belong to the generated subcategory. -/
theorem generatedCategory_finiteSemisimple :
    ∃ (n : ℕ) (S : Fin n → GeneratedCategory C X),
      (∀ i, Simple (S i)) ∧
      (∀ i j, Nonempty (S i ≅ S j) → i = j) ∧
      (∀ Y, ∃ m : Fin n → ℕ,
        Nonempty (Y ≅ ⨁ (fun p : Σ i, Fin (m i) => S p.1))) := by
  classical
  obtain ⟨n, ⟨e⟩⟩ := Finite.exists_equiv_fin (GeneratedSimpleIndex C X)
  let S : Fin n → GeneratedCategory C X := fun i ↦ generatedSimple C X (e.symm i)
  refine ⟨n, S, fun i ↦ generatedSimple_simple C X _, ?_, ?_⟩
  · intro i j hij
    apply e.symm.injective
    exact generatedSimple_injective C X hij
  · intro Y
    let I := MTC.CategoryTheory.Dimensions.simplePieces C Y.obj
    let E := Fintype.equivFin I
    let V : Fin (Fintype.card I) → GeneratedCategory C X := fun j ↦ generatedPieces C X Y (E.symm j)
    have hYV : Nonempty (Y ≅ ⨁ V) := ⟨generatedPiecesDecomposition C X Y ≪≫
      biproduct.whiskerEquiv E (fun a ↦ eqToIso (by simp [V]))⟩
    have hcover (j : Fin (Fintype.card I)) : ∃ i, Nonempty (V j ≅ S i) := by
      let a := E.symm j
      let b : GeneratedSimpleIndex C X := ⟨a.1, (mem_generatedLabels C X _).mpr (generated_piece C X Y a)⟩
      refine ⟨e b, ⟨eqToIso ?_⟩⟩
      simp [V, S, b, a, generatedPieces, generatedSimple]
    obtain ⟨m, ⟨ev⟩⟩ := MTC.Center.Induction.regroup_biproduct hcover
    exact ⟨m, hYV.map fun e' ↦ e' ≪≫ ev⟩

instance generatedCategory_fusion : IsFusionCategory (GeneratedCategory C X) where
  hom_finite Y Z := by
    let : FiniteDimensional ℂ ((generatedProperty C X).ι.obj Y ⟶ (generatedProperty C X).ι.obj Z) := by
      change FiniteDimensional ℂ (Y.obj ⟶ Z.obj)
      exact IsFusionCategory.hom_finite Y.obj Z.obj
    exact FiniteDimensional.of_injective ((generatedProperty C X).ι.mapLinearMap ℂ)
      (fun _ _ h ↦ (generatedProperty C X).ι.map_injective h)
  unit_simple := by
    let F := (generatedProperty C X).ι
    let : Simple (F.obj (𝟙_ (GeneratedCategory C X))) := by
      change Simple (𝟙_ C.Obj)
      exact IsFusionCategory.unit_simple
    exact Functor.simple_of_simple_obj F _
  finite_semisimple := generatedCategory_finiteSemisimple C X

/-- The actual generated braided fusion category. -/
def bundledGenerated : BraidedFusionCategory.{v,u} where
  Obj := GeneratedCategory C X

/-- The generator as an object of its actual generated fusion category. -/
def generatedObject : GeneratedCategory C X := ⟨X, generatedBy_self X⟩

set_option backward.isDefEq.respectTransparency false in
set_option backward.defeqAttrib.useBackward true in
/-- Inclusion of the generated fusion category preserves FP dimensions. -/
theorem generated_forget_fpDimension (Y : GeneratedCategory C X) :
    fpDimension C Y.obj = fpDimension (bundledGenerated C X) Y := by
  let F : GeneratedCategory C X ⥤ C.Obj := (generatedProperty C X).ι
  let hAdd : F.Additive := ⟨by intros; rfl⟩
  let hFaithful : F.Faithful := inferInstance
  let hMonoidal : F.Monoidal := inferInstance
  exact @fpDimension_functor (bundledGenerated C X) C F hAdd hFaithful hMonoidal Y

/-- A simple generator remains simple in its full generated category. -/
theorem generatedObject_simple [Simple X] : Simple (generatedObject C X) := by
  let F := (generatedProperty C X).ι
  let : Simple (F.obj (generatedObject C X)) := by
    change Simple X
    infer_instance
  exact Functor.simple_of_simple_obj F _

/-- The objectwise manuscript conclusion, with the actual generated braided
fusion category. This definition records the target and does not assert it. -/
def ObjectwiseStatement : Prop :=
  ∀ (D : BraidedFusionCategory.{v,u}) (Y : D.Obj), [Simple Y] →
    ((Nonempty (MTC.CategoryTheory.Dimensions.PivotalStructure
        (C := (bundledGenerated D Y).Obj)) ∧ IsNondegenerate (bundledGenerated D Y)) ∨
      HasPseudoUnitaryGaloisConjugate (bundledGenerated D Y)) →
    ¬ WeaklyIntegral (fpDimension D Y ^ 2) →
      ∃ n, ∀ m ≥ n, Infinite (braidImage Y m)

end MTC.PropertyF.Pivotal
end
