module
public import MTC.PropertyF.Pivotal.GeneratedConsequences
public import MTC.PropertyF.Pivotal.InfiniteImages

/-! # Objectwise consequences conditional on the closure lemma -/

@[expose] public noncomputable section
open CategoryTheory MTC.Fusion MTC.Braided MTC.CategoryTheory.Dimensions
namespace MTC.PropertyF.Pivotal
universe v u
variable (C : BraidedFusionCategory.{v,u}) (X : C.Obj) [Simple X]
local notation "G" => bundledGenerated C X

omit [Simple X] in
/-- The closure lemma transfers any failure of property F in the actual
category generated by X to X itself. -/
theorem not_objectPropertyF_of_generated_not_propertyF
    (hclosure : ClosureStatement.{v,u})
    (hnot : ¬ HasPropertyF (bundledGenerated C X).Obj) : ¬ ObjectPropertyF X := by
  intro hX
  apply hnot
  apply (generated_propertyF_iff_ambient C X).2
  intro Y hY
  exact hclosure C X Y hX hY

/-- The objectwise corollary in the pseudo-unitary-conjugate case, with the
closure lemma exposed as its only additional input. -/
theorem eventually_infinite_of_generated_conjugate_of_closure
    (hclosure : ClosureStatement.{v,u})
    (hconj : HasPseudoUnitaryGaloisConjugate G)
    (hX : ¬ WeaklyIntegral (fpDimension C X ^ 2)) :
    ∃ n, ∀ m ≥ n, Infinite (braidImage X m) :=
  eventually_infinite_braidImages_of_not_objectPropertyF C X <|
    not_objectPropertyF_of_generated_not_propertyF C X hclosure <|
      generated_not_propertyF_of_nonintegral_sq_of_conjugate C X hconj hX

/-- The corresponding objectwise conclusion under actual S invertibility of
the generated pivotal category, conditional only on the closure lemma. -/
theorem eventually_infinite_of_generated_invertibleS_of_closure
    (hclosure : ClosureStatement.{v,u})
    (p : PivotalStructure (C := (bundledGenerated C X).Obj))
    (hdet : (MTC.Modular.categoricalS G p).det ≠ 0)
    (hX : ¬ WeaklyIntegral (fpDimension C X ^ 2)) :
    ∃ n, ∀ m ≥ n, Infinite (braidImage X m) :=
  eventually_infinite_braidImages_of_not_objectPropertyF C X <|
    not_objectPropertyF_of_generated_not_propertyF C X hclosure <|
      generated_not_propertyF_of_nonintegral_sq_of_invertibleS C X p hdet hX

end MTC.PropertyF.Pivotal
end
