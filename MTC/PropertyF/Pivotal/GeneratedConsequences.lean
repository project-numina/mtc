module
public import MTC.PropertyF.Pivotal.GeneratedCategory
public import MTC.PropertyF.Pivotal.FPSquareIntegral
public import MTC.PropertyF.Pivotal.ConjugateCorollary

/-! # Dimension obstructions inside the generated fusion category -/

@[expose] public noncomputable section
open CategoryTheory MTC.Fusion MTC.Braided MTC.CategoryTheory.Dimensions
namespace MTC.PropertyF.Pivotal
set_option linter.style.haveILetI false
set_option backward.isDefEq.respectTransparency false
universe v u
variable (C : BraidedFusionCategory.{v,u}) (X : C.Obj) [Simple X]
local notation "G" => bundledGenerated C X

omit [Simple X] in
/-- The generated full category has property F exactly when its actual
objects have finite braid images in the ambient category. -/
theorem generated_propertyF_iff_ambient :
    HasPropertyF (bundledGenerated C X).Obj ↔
      ∀ Y : C.Obj, GeneratedBy X Y → ObjectPropertyF Y := by
  let F : GeneratedCategory C X ⥤ C.Obj := (generatedProperty C X).ι
  constructor
  · intro h Y hY n
    let V : GeneratedCategory C X := ⟨Y, hY⟩
    exact Finite.of_equiv (braidImage V n) (h := h V n)
      (MTC.Modular.braidImageFunctorIso F V n).toEquiv
  · intro h V n
    exact Finite.of_equiv (braidImage V.obj n) (h := h V.obj V.property n)
      (MTC.Modular.braidImageFunctorIso F V n).symm.toEquiv


/-- Nonintegral squared FP dimension obstructs property F of the actual
category generated by X when that category has a pseudo-unitary conjugate. -/
theorem generated_not_propertyF_of_nonintegral_sq_of_conjugate
    (hconj : HasPseudoUnitaryGaloisConjugate G)
    (hX : ¬ WeaklyIntegral (fpDimension C X ^ 2)) : ¬ HasPropertyF (bundledGenerated C X).Obj := by
  intro hF
  have hw := (pseudoUnitary_and_weaklyIntegral_of_propertyF_of_conjugate G hconj hF).2
  let Y := generatedObject C X
  letI : Simple Y := generatedObject_simple C X
  have hi := simple_fpDimension_sq_integral_of_weaklyIntegral G hw Y
  apply hX
  change WeaklyIntegral (fpDimension C Y.obj ^ 2)
  rw [generated_forget_fpDimension C X Y]
  exact hi

/-- The same obstruction holds for a pivotal generated category with an
invertible actual S matrix. -/
theorem generated_not_propertyF_of_nonintegral_sq_of_invertibleS
    (p : PivotalStructure (C := (bundledGenerated C X).Obj))
    (hdet : (MTC.Modular.categoricalS G p).det ≠ 0)
    (hX : ¬ WeaklyIntegral (fpDimension C X ^ 2)) : ¬ HasPropertyF (bundledGenerated C X).Obj := by
  intro hF
  have hw := weaklyIntegral_of_invertibleS_of_propertyF G p hdet hF
  let Y := generatedObject C X
  letI : Simple Y := generatedObject_simple C X
  have hi := simple_fpDimension_sq_integral_of_weaklyIntegral G hw Y
  apply hX
  change WeaklyIntegral (fpDimension C Y.obj ^ 2)
  rw [generated_forget_fpDimension C X Y]
  exact hi

end MTC.PropertyF.Pivotal
end
