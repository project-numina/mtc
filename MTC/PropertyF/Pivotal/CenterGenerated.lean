module
public import MTC.Center.Normalization.ProductGenerator
public import MTC.PropertyF.Pivotal.GeneratedConsequences

/-! # Property F of the actual canonical-image join -/

@[expose] public noncomputable section
open CategoryTheory MTC.Fusion MTC.Braided
namespace MTC.PropertyF.Pivotal
set_option backward.isDefEq.respectTransparency false
universe v u
variable (C : BraidedFusionCategory.{v,u})
variable [RigidCategory (CategoryTheory.Center C.Obj)]
variable [IsFusionCategory (CategoryTheory.Center C.Obj)]
local notation "Z" => MTC.PropertyF.Reduction.bundledCenter C

/-- The actual fusion category generated by the two canonical centre images
has property F if the base category does. Its objects are exactly the product
retracts, by `generatedBy_productGenerator_iff_productRetract`. -/
theorem canonicalJoin_propertyF (hF : HasPropertyF C.Obj) :
    HasPropertyF (bundledGenerated Z (MTC.Center.Normalization.productGenerator C)).Obj := by
  apply (generated_propertyF_iff_ambient Z (MTC.Center.Normalization.productGenerator C)).2
  intro W hW
  exact MTC.Center.productRetract_propertyF
    ((MTC.Center.Normalization.generatedBy_productGenerator_iff_productRetract C W).mp hW) hF

end MTC.PropertyF.Pivotal
end
